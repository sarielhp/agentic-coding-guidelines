#!/usr/bin/env ruby
# frozen_string_literal: true

# ==============================================================================
# ~/prog/standards/ruby/bin/ruby-static-analysis
#
# Static analysis orchestrator for Ruby codebases:
# 1. Syntax Validation: ruby -cw
# 2. Idiom & Style Hygiene: rubocop (with fallback to standards baseline)
# 3. Supply-Chain Security: bundle-audit (Ruby Advisory Database)
# 4. Clone & Duplication: dupl AST clone detector
# ==============================================================================

require 'open3'
require 'optparse'

VERSION = '0.2.0'
STANDARDS_RUBOCOP = File.expand_path('../../templates/dot_rubocop.yml', File.realpath(__FILE__))

options = {
  syntax: false,
  rubocop: false,
  vuln: false,
  dups: false,
  quiet: false,
  strict: false,
  threshold: 50
}

OptionParser.new do |opts|
  opts.banner = 'Usage: ruby-static-analysis [options] [paths...]'
  opts.on('--syntax', 'Run only Ruby syntax check (ruby -cw)') { options[:syntax] = true }
  opts.on('--rubocop', 'Run only RuboCop style and idiom analysis') { options[:rubocop] = true }
  opts.on('--vuln', 'Run only dependency vulnerability check (bundle-audit)') { options[:vuln] = true }
  opts.on('--dups', 'Run only code clone and duplication detector (dupl)') { options[:dups] = true }
  opts.on('-t', '--threshold TOKENS', Integer, "Clone threshold (default: #{options[:threshold]})") do |v|
    options[:threshold] = v
  end
  opts.on('-q', '--quiet', 'Show only sections with findings') { options[:quiet] = true }
  opts.on('--strict', 'Exit with error code if any warnings or issues are found') { options[:strict] = true }
  opts.on('--version', 'Show version and exit') do
    puts "ruby-static-analysis v#{VERSION}"
    exit 0
  end
  opts.on('-h', '--help', 'Show this help message') do
    puts opts
    exit 0
  end
end.parse!

target_paths = ARGV.empty? ? ['.'] : ARGV
single_file_target = target_paths.size == 1 && File.file?(target_paths.first)

run_all = !options[:syntax] && !options[:rubocop] && !options[:vuln] && !options[:dups]
total_issues = 0

def tool_available?(name)
  ENV['PATH'].to_s.split(File::PATH_SEPARATOR).any? do |dir|
    bin = File.join(dir, name)
    File.file?(bin) && File.executable?(bin)
  end
end

def puts_header(title)
  puts "\n\e[1;36m=== #{title} ===\e[0m"
end

def search_dir_upward_for_config(start_dir)
  dir = start_dir
  while dir && dir != '/' && dir != '.'
    candidate = File.join(dir, '.rubocop.yml')
    return candidate if File.file?(candidate)
    break if File.exist?(File.join(dir, '.git'))

    dir = File.dirname(dir)
  end
  nil
end

def find_rubocop_config(paths)
  config = search_dir_upward_for_config(Dir.pwd)
  return config if config

  paths.each do |p|
    dir = File.file?(p) ? File.dirname(File.expand_path(p)) : File.expand_path(p)
    found = search_dir_upward_for_config(dir)
    return found if found
  end
  nil
end

# 1. Syntax Validation (ruby -cw)
if run_all || options[:syntax]
  puts_header('Ruby Syntax Validation (ruby -cw)') unless options[:quiet]
  syntax_errors = []

  files = target_paths.flat_map do |p|
    if File.directory?(p)
      Dir.glob(File.join(p, '**', '*.rb'))
    elsif File.file?(p)
      [p]
    else
      Dir.glob(p)
    end
  end
  files = files.uniq.select { |f| File.file?(f) && !f.include?('/vendor/') && !f.include?('/junk/') }

  files.each do |f|
    _, err, status = Open3.capture3("ruby -cw #{f}")
    unless status.success? && (err.empty? || err.strip == 'Syntax OK')
      clean_err = err.lines.reject { |l| l.strip == 'Syntax OK' }.join.strip
      syntax_errors << "  \e[31m#{f}\e[0m:\n#{clean_err}" unless clean_err.empty?
    end
  end

  if syntax_errors.empty?
    puts "  \e[32m✔ Syntax OK across #{files.size} file(s)\e[0m" unless options[:quiet]
  else
    puts "\e[31m❌ Syntax errors detected:\e[0m"
    syntax_errors.each { |e| puts e }
    total_issues += syntax_errors.size
  end
end

# 2. RuboCop
if run_all || options[:rubocop]
  if tool_available?('rubocop')
    puts_header('RuboCop Style & Idiom Analysis') unless options[:quiet]

    local_config = find_rubocop_config(target_paths)
    if local_config
      rubocop_cmd = "rubocop #{target_paths.join(' ')}"
    elsif File.file?(STANDARDS_RUBOCOP)
      puts "  \e[36mℹ No local .rubocop.yml found; using standards baseline\e[0m" unless options[:quiet]
      rubocop_cmd = "rubocop --config #{STANDARDS_RUBOCOP} #{target_paths.join(' ')}"
    else
      rubocop_cmd = "rubocop --lint #{target_paths.join(' ')}"
    end

    out, err, status = Open3.capture3(rubocop_cmd)
    if status.success?
      puts "  \e[32m✔ RuboCop passed with 0 offenses\e[0m" unless options[:quiet]
    else
      puts out unless out.strip.empty?
      puts err unless err.strip.empty?
      total_issues += 1
    end
  else
    puts "  \e[33mℹ RuboCop not installed (run ruby-install-tools)\e[0m" unless options[:quiet]
  end
end

# 3. Supply-Chain Vulnerabilities (bundle-audit)
# Only run for repository/project scopes or explicit --vuln request, not single-file sweeps
run_vuln = ((run_all && !single_file_target) || options[:vuln]) && File.exist?('Gemfile.lock')
if run_vuln
  if tool_available?('bundle-audit')
    puts_header('Dependency Vulnerability Audit (bundle-audit)') unless options[:quiet]
    out, err, status = Open3.capture3('bundle-audit check')
    if status.success?
      puts "  \e[32m✔ No known vulnerabilities found\e[0m" unless options[:quiet]
    else
      puts out unless out.strip.empty?
      puts err unless err.strip.empty?
      total_issues += 1
    end
  else
    puts "  \e[33mℹ bundle-audit not installed (run ruby-install-tools)\e[0m" unless options[:quiet]
  end
end

# 4. AST Duplication & Clone Detection (dupl)
# Only run for multi-file/directory scopes or explicit --dups request
run_dups = ((run_all && !single_file_target) || options[:dups]) && tool_available?('dupl')
if run_dups
  puts_header("Code Clone & Duplication Detector (dupl, threshold: #{options[:threshold]})") unless options[:quiet]
  dupl_cmd = "dupl -t #{options[:threshold]} #{target_paths.join(' ')}"
  out, _err, _status = Open3.capture3(dupl_cmd)
  clones = out.lines.grep(/^.*?:\d+-\d+:\s+duplicate of/)
  if clones.empty?
    puts "  \e[32m✔ No clones found above threshold #{options[:threshold]}\e[0m" unless options[:quiet]
  else
    puts "\e[33m⚠️ Potential clones detected:\e[0m"
    puts out
    total_issues += clones.size if options[:strict]
  end
end

if total_issues.positive? && options[:strict]
  puts "\n\e[31m❌ ruby-static-analysis failed: #{total_issues} issue(s) detected.\e[0m"
  exit 1
end

exit 0
