#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require 'tempfile'
require File.join(__dir__, 'analysis_support')

STANDARDS_RUBOCOP = File.expand_path('../templates/dot_rubocop.yml', __dir__)
selected = []
mass = 50
temporary_config = nil
quiet = false

begin
  OptionParser.new do |opts|
    opts.banner = 'Usage: ruby-static-analysis [checks] [paths...]'
    %i[syntax rubocop vuln dups].each { |key| opts.on("--#{key}", "Run #{key} check") { selected << key } }
    opts.on('-t', '--threshold MASS', Integer, 'Flay mass threshold (default 50)') { |value| mass = value }
    opts.on('--strict', 'Compatibility option; failures always exit nonzero') { selected.uniq! }
    opts.on('-q', '--quiet', 'Suppress headings') { quiet = true }
    opts.on('--version', 'Show version') do
      puts 'ruby-static-analysis v0.3.0'
      exit
    end
    opts.on('-h', '--help', 'Show help') do
      puts opts
      exit
    end
  end.parse!
  ENV['PATH'] = (ENV.fetch('PATH', '').split(File::PATH_SEPARATOR) +
    [Gem.bindir, File.join(Gem.user_dir, 'bin')]).uniq.join(File::PATH_SEPARATOR)
  paths = ARGV.empty? ? ['.'] : ARGV
  files = AnalysisSupport.ruby_files(paths)
  abort 'no Ruby sources found in requested paths' if files.empty?
  single = paths.length == 1 && File.file?(paths.first)
  if selected.empty?
    selected = %i[syntax rubocop]
    selected << :vuln if !single && File.file?('Gemfile.lock')
    selected << :dups unless single
  end
  AnalysisSupport.syntax(files) if selected.include?(:syntax)
  if selected.include?(:rubocop)
    config = []
    project_config = AnalysisSupport.project_config(files)
    if project_config
      config = ['--config', project_config]
    else
      temporary_config = Tempfile.new(['ruby-review', '.yml'])
      version = RUBY_VERSION.split('.').first(2).join('.')
      temporary_config.write("inherit_from: #{STANDARDS_RUBOCOP}\nAllCops:\n  TargetRubyVersion: #{version}\n")
      temporary_config.flush
      config = ['--config', temporary_config.path]
    end
    AnalysisSupport.run('rubocop', *config, *files)
  end
  if selected.include?(:vuln)
    abort 'dependency audit requires Gemfile.lock' unless File.file?('Gemfile.lock')
    AnalysisSupport.run('bundle-audit', 'check')
  end
  AnalysisSupport.flay(files, mass) if selected.include?(:dups)
  puts 'Static review passed' unless quiet
rescue StandardError => e
  abort e.message
ensure
  temporary_config&.close!
end
