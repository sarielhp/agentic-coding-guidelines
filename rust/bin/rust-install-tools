#!/usr/bin/env ruby
# frozen_string_literal: true

require 'open3'
require 'optparse'

ENV['PATH'] = "#{File.expand_path('~/.cargo/bin')}:#{ENV['PATH']}"

TOOLS = {
  # Fast binary installer
  'cargo-binstall' => { crate: 'cargo-binstall', desc: 'Fast binary installer for cargo tools' },
  # Security & Supply Chain
  'cargo-audit' => { crate: 'cargo-audit', desc: 'Vulnerability scanner (RustSec CVEs)' },
  'cargo-deny' => { crate: 'cargo-deny', desc: 'Supply-chain, license, and dependency ban checker' },
  'cargo-machete' => { crate: 'cargo-machete', desc: 'Unused dependencies scanner for Cargo.toml' },
  'cargo-geiger' => { crate: 'cargo-geiger', desc: 'Unsafe code usage auditor' },
  # Testing & Quality Verification
  'cargo-nextest' => { crate: 'cargo-nextest', desc: 'Ultra-fast parallel test runner' },
  'cargo-mutants' => { crate: 'cargo-mutants', desc: 'Mutation testing tool to verify test quality' },
  # API & Dependency Hygiene
  'cargo-semver-checks' => { crate: 'cargo-semver-checks', desc: 'Semver API breaking change detector' },
  'cargo-outdated' => { crate: 'cargo-outdated', desc: 'Dependency freshness and outdatedness checker' },
  'cargo-expand' => { crate: 'cargo-expand', desc: 'Macro expansion and compiler desugaring inspector' }
}.freeze

options = {
  dry_run: false,
  force: false,
  only: nil
}

OptionParser.new do |opts|
  opts.banner = 'Usage: rust-install-tools [options] [tool_names...]'
  opts.on('--dry-run', 'Show which tools would be installed without installing') { options[:dry_run] = true }
  opts.on('--force', 'Reinstall tools even if already present in PATH') { options[:force] = true }
  opts.on('-l', '--list', 'List available tools and descriptions') do
    puts "\e[1mAvailable Rust Analysis & Productivity Tools:\e[0m\n\n"
    TOOLS.each do |binary, info|
      installed = `which #{binary} 2>/dev/null`.strip
      status = installed.empty? ? "\e[33m[not installed]\e[0m" : "\e[32m[installed: #{installed}]\e[0m"
      puts format("  \e[1m%-22s\e[0m %-18s %s", binary, status, info[:desc])
    end
    exit 0
  end
  opts.on('-h', '--help', 'Show this help') do
    puts opts
    exit 0
  end
end.parse!

selected_tools = ARGV.empty? ? TOOLS.keys : ARGV

puts "\e[1m=== Installing Rust Static Code Analysis & Productivity Tools ===\e[0m\n"
puts "Target installation directory: ~/.cargo/bin/\n\n"

installed = 0
failed = 0
skipped = 0

has_binstall = !`which cargo-binstall 2>/dev/null`.strip.empty?

selected_tools.each do |binary|
  info = TOOLS[binary]
  unless info
    warn "  \e[33m[SKIP]\e[0m Unknown tool: #{binary}"
    skipped += 1
    next
  end

  crate = info[:crate]
  bin_path = `which #{binary} 2>/dev/null`.strip

  if !bin_path.empty? && File.executable?(bin_path) && !options[:force]
    puts "  \e[32m✔\e[0m #{binary} already installed at #{bin_path}"
    installed += 1
    next
  end

  if options[:dry_run]
    puts "  \e[36m[DRY-RUN]\e[0m Would install #{binary} (#{info[:desc]})"
    next
  end

  # Try cargo binstall if available (except for installing cargo-binstall itself)
  cmd = if has_binstall && binary != 'cargo-binstall'
          puts "  Installing #{binary} (#{info[:desc]}) via cargo-binstall..."
          "cargo binstall -y #{crate}"
        else
          puts "  Installing #{binary} (#{info[:desc]}) via cargo install..."
          "cargo install #{crate} --locked"
        end

  stdout, stderr, status = Open3.capture3(cmd)

  # If binstall fails, fall back to standard cargo install
  if !status.success? && has_binstall && binary != 'cargo-binstall'
    puts "  \e[33mNotice:\e[0m binstall failed, falling back to cargo install --locked..."
    stdout, stderr, status = Open3.capture3("cargo install #{crate} --locked")
  end

  if status.success?
    puts "  \e[32m✔\e[0m Successfully installed #{binary}"
    installed += 1
    has_binstall = true if binary == 'cargo-binstall'
  else
    puts "  \e[31m✗\e[0m Failed to install #{binary}:"
    puts stderr unless stderr.empty?
    puts stdout if stderr.empty? && !stdout.empty?
    failed += 1
  end
end

puts "\n\e[1mSummary:\e[0m #{installed} installed/present, #{failed} failed, #{skipped} skipped"
exit(failed.positive? ? 1 : 0)
