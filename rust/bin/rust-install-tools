#!/usr/bin/env ruby
# frozen_string_literal: true

require 'open3'

ENV['PATH'] = "#{File.expand_path('~/.cargo/bin')}:#{ENV['PATH']}"

TOOLS = {
  'cargo-audit' => 'cargo-audit',
  'cargo-deny' => 'cargo-deny',
  'cargo-machete' => 'cargo-machete',
  'cargo-geiger' => 'cargo-geiger'
}.freeze

puts "\e[1m=== Installing Rust Static Code Analysis Tools ===\e[0m\n"
puts "Target installation directory: ~/.cargo/bin/\n\n"

installed = 0
failed = 0

TOOLS.each do |binary, crate|
  bin_path = `which #{binary} 2>/dev/null`.strip
  if !bin_path.empty? && File.executable?(bin_path)
    puts "  \e[32m✔\e[0m #{binary} already installed at #{bin_path}"
    installed += 1
    next
  end

  puts "  Installing #{crate} via cargo install..."
  stdout, stderr, status = Open3.capture3("cargo install #{crate} --locked")
  if status.success?
    puts "  \e[32m✔\e[0m Successfully installed #{binary}"
    installed += 1
  else
    puts "  \e[31m✗\e[0m Failed to install #{binary}:"
    puts stderr unless stderr.empty?
    failed += 1
  end
end

puts "\n\e[1mSummary:\e[0m #{installed} installed/present, #{failed} failed"
exit(failed.positive? ? 1 : 0)
