#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'

MAX_LINES = 1100
SOFT_LIMIT = 800
MAX_FUNC_LINES = 110
BUILDER_FUNC_LIMIT = 160
DISPATCHER_FUNC_LIMIT = 200
TEST_FUNC_LIMIT = 250
MAX_DEPTH = 4
MAX_BRANCHES = 15
BUILDER_BRANCHES = 20

options = {
  max: MAX_LINES,
  soft: SOFT_LIMIT,
  max_func: MAX_FUNC_LINES,
  builder_max: BUILDER_FUNC_LIMIT,
  dispatcher_max: DISPATCHER_FUNC_LIMIT,
  test_func_max: TEST_FUNC_LIMIT,
  max_depth: MAX_DEPTH,
  max_branches: MAX_BRANCHES,
  builder_branches: BUILDER_BRANCHES,
  quiet: false,
  strict: false,
  include_tests: false,
  check_unwraps: true
}

OptionParser.new do |opts|
  opts.banner = 'Usage: rust-audit [options] [directory]'
  opts.on('-m', '--max LINES', Integer, "Hard limit for file lines (default: #{MAX_LINES})") { |v| options[:max] = v }
  opts.on('-s', '--soft LINES', Integer, "Warning threshold for file lines (default: #{SOFT_LIMIT})") { |v| options[:soft] = v }
  opts.on('-f', '--max-func LINES', Integer, "Hard limit for function lines (default: #{MAX_FUNC_LINES})") { |v| options[:max_func] = v }
  opts.on('--builder-max LINES', Integer, "Limit for low-complexity builder/CLI functions (default: #{BUILDER_FUNC_LIMIT})") { |v| options[:builder_max] = v }
  opts.on('--dispatcher-max LINES', Integer, "Limit for flat match/event dispatchers (default: #{DISPATCHER_FUNC_LIMIT})") { |v| options[:dispatcher_max] = v }
  opts.on('--test-func-max LINES', Integer, "Limit for test functions (default: #{TEST_FUNC_LIMIT})") { |v| options[:test_func_max] = v }
  opts.on('--max-depth DEPTH', Integer, "Hard limit for control-flow nesting depth (default: #{MAX_DEPTH})") { |v| options[:max_depth] = v }
  opts.on('--max-branches BRANCHES', Integer, "Hard limit for function branch complexity (default: #{MAX_BRANCHES})") { |v| options[:max_branches] = v }
  opts.on('--include-tests', 'Apply production function limit to test functions and test files') { options[:include_tests] = true }
  opts.on('--no-unwrap-check', 'Disable checks for unwrap/expect in production code') { options[:check_unwraps] = false }
  opts.on('--strict', 'Exit with error code if any file or function exceeds hard limit') { options[:strict] = true }
  opts.on('-q', '--quiet', 'Show only warnings and violations') { options[:quiet] = true }
  opts.on('-h', '--help', 'Show this help') do
    puts opts
    exit 0
  end
end.parse!

target_dir = ARGV[0] ? File.expand_path(ARGV[0]) : Dir.pwd
unless File.directory?(target_dir)
  warn "Error: Target directory not found: #{target_dir}"
  exit 1
end

def clean_code_line(line, in_block_comment)
  l = line.dup
  if in_block_comment
    if l =~ %r{\*/}
      l = l.sub(%r{^.*?\*/}, '')
      in_block_comment = false
    else
      return ['', true]
    end
  end
  l = l.gsub(%r{/\*.*?\*/}, '')
  if l =~ %r{/\*}
    l = l.sub(%r{/\*.*$}, '')
    in_block_comment = true
  end
  l = l.sub(%r{//.*$}, '')
  # Strip raw string literals r#"..."# or r"..."
  l = l.gsub(/r#*".*?"#*/, '""')
  # Strip regular string literals
  l = l.gsub(/"(?:[^"\\]|\\.)*"/, '""')
  # Strip character literals
  l = l.gsub(/'(?:[^'\\]|\\.)'/, "''")
  [l, in_block_comment]
end

def count_branches(lines)
  branches = 0
  in_block_comment = false
  lines.each do |line|
    l, in_block_comment = clean_code_line(line, in_block_comment)
    next if l.strip.empty?

    # Count branching keywords
    branches += l.scan(/\b(?:if|for|while|loop|match)\b/).size
  end
  branches
end

def check_style_issues(func_lines, is_test, check_unwraps)
  issues = []
  in_block_comment = false
  has_safety_doc = false

  func_lines.each_with_index do |line, idx|
    # Look for safety documentation before unsafe
    if line =~ %r{//\s*SAFETY:}i
      has_safety_doc = true
      next
    end

    l, in_block_comment = clean_code_line(line, in_block_comment)
    next if l.strip.empty?

    # Else after terminal statement check
    if l =~ /\}\s*else\b/
      prev = func_lines[0...idx].reverse.find { |pl| pl !~ %r{^\s*(?://|/\*|\*|$)} }
      if prev =~ /^\s*(?:return\b|break\b|continue\b|panic!\b|bail!\b|todo!\b)/
        issues << "else after terminal statement at line #{idx + 1}"
      end
    end

    # Bare unsafe check
    if l =~ /\bunsafe\s*(?:\{|fn\b)/
      issues << "bare unsafe without // SAFETY: proof at line #{idx + 1}" unless has_safety_doc
      has_safety_doc = false
    end

    # Unwrap / expect in production code check
    if !is_test && check_unwraps
      prev_comment = idx.positive? ? func_lines[idx - 1] : ''
      has_invariant = prev_comment.include?('// INVARIANT:') || line.include?('// INVARIANT:')
      is_lock_unwrap = l =~ /\.(?:lock|read|write)\s*\([^)]*\)\s*\.(?:unwrap|expect)\s*\(/
      is_static_init = line =~ /\b(?:LazyLock|lazy_static)\b/
      if (l =~ /\.(?:unwrap|expect)\s*\(/) && !has_invariant && !is_lock_unwrap && !is_static_init
        issues << "production unwrap/expect without // INVARIANT: at line #{idx + 1}"
      end
    end

    has_safety_doc = false if l =~ /;/
  end
  issues
end

def scan_functions(lines, file_is_test, options)
  funcs = []
  in_func = false
  func_name = ''
  start_line = 0
  brace_depth = 0
  control_depth = 0
  max_depth = 0
  func_is_test = file_is_test
  recent_attributes = []
  in_block_comment = false
  in_test_mod_depth = nil
  file_brace_depth = 0

  lines.each_with_index do |line, idx|
    raw = line.strip

    # Track mod tests / cfg(test)
    if raw =~ /mod\s+tests\b/ || (recent_attributes.any? { |a| a.include?('cfg(test)') } && raw =~ /mod\s+\w+/)
      in_test_mod_depth = file_brace_depth
    end

    # Track outer test attributes
    if raw.start_with?('#[')
      recent_attributes << raw
      next
    elsif raw.empty? || raw.start_with?('//')
      next
    end

    # Function start detection
    fn_match = line.match(/^\s*(?:pub(?:\([^)]+\))?\s+)?(?:async\s+)?(?:unsafe\s+)?(?:extern(?:\s+"[^"]+")?\s+)?fn\s+([A-Za-z0-9_]+)/)
    if fn_match && !in_func
      in_func = true
      func_name = fn_match[1]
      start_line = idx + 1
      brace_depth = 0
      control_depth = 0
      max_depth = 0
      func_is_test = file_is_test ||
                     !in_test_mod_depth.nil? ||
                     func_name.start_with?('test_') ||
                     func_name.end_with?('_test') ||
                     recent_attributes.any? { |a| a.include?('test') || a.include?('cfg(test)') }
      recent_attributes = []
    end

    recent_attributes = [] if !in_func && !raw.start_with?('#[')

    clean, in_block_comment = clean_code_line(line, in_block_comment)

    file_brace_depth += clean.count('{') - clean.count('}')
    if in_test_mod_depth && file_brace_depth <= in_test_mod_depth
      in_test_mod_depth = nil
    end

    next unless in_func

    # Track control depth (ignore let-else guards as persistent nesting)
    if clean =~ /\b(?:if|for|while|loop|match)\b/ && clean.include?('{') && clean !~ /\blet\b.*=\s*.*else\s*\{/
      control_depth += 1
      max_depth = [max_depth, control_depth].max
    end

    if clean.include?('}') && control_depth.positive? && clean !~ /fn\s+/
      control_depth -= [clean.count('}'), control_depth].min
    end

    brace_depth += clean.count('{') - clean.count('}')

    next unless brace_depth <= 0 && clean.include?('}')

    func_len = (idx + 1) - start_line + 1
    func_lines = lines[(start_line - 1)..idx]
    branches = count_branches(func_lines)

    is_dispatcher = func_name.start_with?('handle') || func_name.start_with?('dispatch') ||
                    func_name.start_with?('match_') || func_name.start_with?('route')
    is_builder = func_name.start_with?('build') || func_name.start_with?('render') ||
                 func_name.start_with?('init') || func_name.start_with?('generate') ||
                 func_name.start_with?('cli') || func_name.start_with?('args')

    limit = if func_is_test && !options[:include_tests]
              options[:test_func_max]
            elsif is_dispatcher && max_depth <= 2
              options[:dispatcher_max]
            elsif is_builder && max_depth <= 3
              options[:builder_max]
            else
              options[:max_func]
            end

    branch_limit = is_builder || is_dispatcher ? options[:builder_branches] : options[:max_branches]

    issues = []
    issues << "#{func_len} lines (limit #{limit})" if func_len > limit
    issues << "depth #{max_depth} (limit #{options[:max_depth]})" if max_depth > options[:max_depth]
    issues << "#{branches} branches (limit #{branch_limit})" if (!func_is_test || options[:include_tests]) && branches > branch_limit

    style_issues = check_style_issues(func_lines, func_is_test, options[:check_unwraps])
    issues.concat(style_issues)

    if issues.any?
      funcs << {
        name: func_name,
        line: start_line,
        lines: func_len,
        depth: max_depth,
        branches: branches,
        issues: issues
      }
    end
    in_func = false
  end
  funcs
end

rust_files = Dir.glob(File.join(target_dir, '**', '*.rs')).reject do |f|
  f.include?('/target/') || f.include?('/vendor/') || f.include?('/.git/') || f.include?('/.work/')
end.sort

violations = []
warnings = []
passed = []
long_funcs = []

rust_files.each do |file|
  lines = File.readlines(file)
  rel_path = file.sub("#{target_dir}/", '')
  entry = { path: rel_path, lines: lines.size }

  if lines.size > options[:max]
    violations << entry
  elsif lines.size > options[:soft]
    warnings << entry
  else
    passed << entry
  end

  is_test = rel_path.end_with?('_tests.rs') || rel_path.start_with?('tests/') || rel_path.include?('/tests/')
  scan_functions(lines, is_test, options).each do |fn|
    long_funcs << fn.merge(path: rel_path)
  end
end

puts "\e[1m=== Rust Sizing & Cognitive Audit (#{File.basename(target_dir)}) ===\e[0m"
puts "Functions: hard limit #{options[:max_func]} lines (builders: #{options[:builder_max]}, dispatchers: #{options[:dispatcher_max]}, tests: #{options[:test_func_max]})"
puts "Complexity: max depth #{options[:max_depth]} | max branches #{options[:max_branches]} (builders/dispatchers: #{options[:builder_branches]})"
puts "Files: warn over #{options[:soft]} lines | hard limit #{options[:max]} lines\n\n"

puts "\e[1mFunctions\e[0m"
if long_funcs.empty?
  puts "  \e[32m[PASS]\e[0m all functions meet sizing and cognitive complexity limits"
else
  long_funcs.sort_by { |f| -f[:lines] }.each do |f|
    detail = f[:issues].join(', ')
    puts format("  \e[31m[FAIL]\e[0m %4d lines  %s:%d %s() [%s]", f[:lines], f[:path], f[:line], f[:name], detail)
  end
  puts "\n  Decompose in place — extract named cohesive helpers into the same module."
  puts "  Do not insert .clone() or pass &mut self across helpers to appease the borrow checker."
end

puts "\n\e[1mFiles\e[0m"
unless options[:quiet]
  passed.each do |e|
    puts format("  \e[32m[PASS]\e[0m %4d lines  %s", e[:lines], e[:path])
  end
end

warnings.each do |e|
  puts format("  \e[33m[WARN]\e[0m %4d lines  %s (over #{options[:soft]} lines)", e[:lines], e[:path])
end

violations.each do |e|
  puts format("  \e[31m[FAIL]\e[0m %4d lines  %s (exceeds #{options[:max]} lines)", e[:lines], e[:path])
end

if warnings.empty? && violations.empty? && options[:quiet]
  puts "  \e[32m[PASS]\e[0m no file exceeds #{options[:soft]} lines"
end

puts "\n\e[1mSummary:\e[0m #{rust_files.size} files — #{passed.size} pass, " \
     "#{warnings.size} over #{options[:soft]}, #{violations.size} over #{options[:max]}; " \
     "#{long_funcs.size} function(s) with notices/violations"

if options[:strict] && (violations.any? || long_funcs.any?)
  warn "\n\e[31mError: #{violations.size} file(s) and #{long_funcs.size} function(s) exceed their hard limit in strict mode.\e[0m"
  exit 1
end
exit 0
