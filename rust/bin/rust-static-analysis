#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require File.join(__dir__, 'analysis_support')

CHECKS = {
  clippy: ['cargo', 'clippy', '--offline', '--locked', '--workspace', '--all-targets', '--', '-D', 'warnings'].freeze,
  audit: %w[cargo-audit audit].freeze,
  deny: %w[cargo-deny deny check].freeze,
  machete: %w[cargo-machete machete].freeze,
  geiger: ['cargo-geiger', 'geiger', '--offline', '--locked', '--all-targets'].freeze,
  outdated: %w[cargo-outdated outdated].freeze,
  semver: %w[cargo-semver-checks semver-checks check-release].freeze
}.freeze
DEFAULT_CHECKS = %i[clippy audit deny machete geiger].freeze
selected = []
duplicates = false
quiet = false

begin
  OptionParser.new do |opts|
    opts.banner = 'Usage: rust-static-analysis [checks] [directory]'
    CHECKS.each_key { |key| opts.on("--#{key}", "Run #{key} check") { selected << key } }
    opts.on('--dups', 'Run the project tools/check_duplicates provider') { duplicates = true }
    opts.on('--strict', 'Compatibility option; failures always exit nonzero') { selected.uniq! }
    opts.on('-q', '--quiet', 'Suppress headings') { quiet = true }
    opts.on('-h', '--help', 'Show help') do
      puts opts
      exit
    end
  end.parse!
  abort 'expected at most one target directory' if ARGV.length > 1
  Dir.chdir(File.realpath(ARGV.first || Dir.pwd))
  ENV['PATH'] = (ENV.fetch('PATH', '').split(File::PATH_SEPARATOR) +
    [File.join(ENV.fetch('CARGO_HOME', File.expand_path('~/.cargo')), 'bin')]).uniq.join(File::PATH_SEPARATOR)
  AnalysisSupport.protect_target_dir
  selected = DEFAULT_CHECKS if selected.empty? && !duplicates
  selected.uniq.each { |key| AnalysisSupport.run(*CHECKS.fetch(key)) }
  if duplicates
    provider = File.join(Dir.pwd, 'tools/check_duplicates')
    unless File.file?(provider) && File.executable?(provider)
      abort 'Rust clone review requires an explicit executable tools/check_duplicates provider'
    end
    AnalysisSupport.run(provider)
  end
  puts 'Static review passed' unless quiet
rescue StandardError => e
  abort e.message
end
