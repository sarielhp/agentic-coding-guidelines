# Copy or include; use tools/commit directly for messages with shell metacharacters.
.PHONY: all build gate check ci lint snapshot commit bump install release test audit review static-analysis
all: build
build:
	tools/build
gate:
	tools/gate $(ARGS)
check:
	tools/check $(ARGS)
ci:
	tools/gate --full
lint:
	tools/lint
snapshot:
	tools/snapshot $(ARGS)
commit:
	tools/commit "$(msg)"
bump:
	tools/bump $(ARGS)
install:
	tools/install $(ARGS)
release:
	tools/release $(ARGS)
test:
	tools/test
audit:
	rust-audit --strict --quiet .
review: static-analysis
static-analysis:
	rust-static-analysis
