#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require 'fileutils'
require 'pty'
require 'open3'
require 'date'
require 'time'
require 'json'
require 'English'
require 'set'

begin
  require 'colorize'
rescue LoadError
  class String
    def colorize_code(code)
      "\e[#{code}m#{self}\e[0m"
    end

    def bold; colorize_code('1'); end
    def red; colorize_code('31'); end
    def green; colorize_code('32'); end
    def yellow; colorize_code('33'); end
    def blue; colorize_code('34'); end
    def magenta; colorize_code('35'); end
    def cyan; colorize_code('36'); end
    def gray; colorize_code('90'); end
    def light_cyan; colorize_code('96'); end
  end
end

class String
  def gray
    respond_to?(:light_black) ? light_black : "\e[90m#{self}\e[0m"
  end unless method_defined?(:gray)
end

git_root = `git rev-parse --show-toplevel 2>/dev/null`.strip
REPO_ROOT = git_root.empty? ? File.expand_path('..', __dir__) : git_root
VERSION = '0.1.0' unless defined?(VERSION)
STATE_FILE = File.join(REPO_ROOT, 'reviews', 'state.json')

AUDIT_PROFILES = %w[systems security correctness resilience performance cli].freeze

MODEL_CADENCE = [
  { tier: 'tier0', backend: 'gemini', label: 'Gemini 3.8 Flash (Tier 0 Workhorse)' },
  { tier: 'tier0', backend: 'gemini', label: 'Gemini 3.8 Flash (Tier 0 Workhorse)' },
  { tier: 'standard', backend: 'auto', label: 'Claude / Codex (Tier 1 Standard)' },
  { tier: 'tier0', backend: 'gemini', label: 'Gemini 3.8 Flash (Tier 0 Workhorse)' },
  { tier: 'tier0', backend: 'gemini', label: 'Gemini 3.8 Flash (Tier 0 Workhorse)' },
  { tier: 'standard', backend: 'auto', label: 'Claude / Codex (Tier 1 Standard)' },
  { tier: 'deep', backend: 'auto', label: 'Flagship Opus / Deep (Tier 2 Deep)' }
].freeze

options = {
  profile: 'auto',
  backend: nil,
  tier: nil,
  cadence: 'affinity',
  loop: false,
  max_cycles: 7,
  target: ENV['AUDIT_TARGET'],
  skip_gate: false,
  dry_run: false,
  keep_reviews: false,
  effort: 'high',
  push: true,
  gate_cmd: ENV['GATE_CMD'],
  audit_cmd: ENV['AUDIT_CMD'],
  build_cmd: ENV['BUILD_CMD'],
  reports_dir: ENV['REPORTS_DIR'],
  max_diff_lines: 800,
  strict_diff: false,
  skip_diff_audit: false,
  ignore_version: false,
  config: nil,
  batch_commits: false,
  branch: nil,
  strict_tests: false
}

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: ./tools/review_cycle [options] (or ./tools/review-cycle)'

  opts.on('-p', '--profile PROFILE', "Audit profile (auto|random|#{AUDIT_PROFILES.join('|')}, default: auto)") do |p|
    options[:profile] = p
  end

  opts.on('-b', '--backend BACKEND', 'Override backend (auto|gemini|claude|codex|openai_api)') do |b|
    options[:backend] = b.downcase
  end

  opts.on('-T', '--tier TIER', 'Override model tier (tier0|standard|deep)') do |t|
    options[:tier] = t.downcase
  end

  opts.on('-c', '--cadence TYPE', 'Model rotation cadence (affinity|pyramid|fixed, default: affinity [Codex/Claude Tier 1])') do |c|
    options[:cadence] = c.downcase
  end

  opts.on('-l', '--loop', 'Continuously run review cycles across profiles until all pass clean') do
    options[:loop] = true
  end

  opts.on('-m', '--max-cycles N', Integer, 'Maximum review cycles when looping (default: 7)') do |n|
    options[:max_cycles] = n
  end

  opts.on('-t', '--target PATH', 'Target directory or file for audit (default: auto-detected)') do |t|
    options[:target] = t
  end

  opts.on('-e', '--effort LEVEL', 'Effort level for agy-run-wild (low|medium|high, default: high)') do |e|
    options[:effort] = e
  end

  opts.on('--max-diff-lines N', Integer, 'Maximum diff lines allowed before warning or aborting (default: 800)') do |n|
    options[:max_diff_lines] = n
  end

  opts.on('--strict-diff', 'Roll back and abort cycle if remediation diff exceeds max-diff-lines') do
    options[:strict_diff] = true
  end

  opts.on('--skip-diff-audit', 'Skip differential re-audit of remediation diff') do
    options[:skip_diff_audit] = true
  end

  opts.on('--gate-cmd CMD', 'Command or script to run for quality gate (default: auto-detected)') do |cmd|
    options[:gate_cmd] = cmd
  end

  opts.on('--audit-cmd CMD', 'Command or path to audit executable (default: auto-detected tools/audit)') do |cmd|
    options[:audit_cmd] = cmd
  end

  opts.on('--build-cmd CMD', 'Command to rebuild binary (default: auto-detected)') do |cmd|
    options[:build_cmd] = cmd
  end

  opts.on('--reports-dir DIR', 'Directory for review artifacts (default: reviews, or reports if present)') do |dir|
    options[:reports_dir] = dir
  end

  opts.on('--skip-gate', 'Skip pre-flight quality gate verification') do
    options[:skip_gate] = true
  end

  opts.on('--dry-run', 'Run audit and create review report without dispatching remediation') do
    options[:dry_run] = true
  end

  opts.on('--keep-reviews', 'Do not move completed reviews to archive directory') do
    options[:keep_reviews] = true
  end

  opts.on('--no-push', 'Do not push commits to remote after review cycle completion') do
    options[:push] = false
  end

  opts.on('--batch-commits', 'Defer remote git push until all review cycles in --loop mode complete') do
    options[:batch_commits] = true
  end

  opts.on('--branch [NAME]', 'Run review cycles on an isolated feature branch (default: review-cycle/<date>)') do |br|
    options[:branch] = br || true
  end

  opts.on('--strict-tests', 'Abort cycle and roll back if test-weakening or assertion-deficit is detected') do
    options[:strict_tests] = true
  end

  opts.on('--doctor', 'Check environment prerequisites (git, bws, agy-run-wild, audit) and exit') do
    MultiProfileReviewCycle.run_doctor
    exit 0
  end

  opts.on('--config PATH', 'Explicit path to configuration file (default: tools/review_cycle.json)') do |c|
    options[:config] = c
  end

  opts.on('--archive', 'Archive completed review reports and plans into archive directory (untracked by git)') do
    MultiProfileReviewCycle.archive_all(options)
    exit 0
  end

  opts.on('--status', 'Display current rotation state, cadence step, and cycle history') do
    MultiProfileReviewCycle.show_status(options)
    exit 0
  end

  opts.on('--reset-state', 'Reset review state machine (state.json) to initial state') do
    MultiProfileReviewCycle.reset_state(options)
    exit 0
  end

  opts.on('--init-config [PATH]', 'Generate a default review_cycle.json configuration for this repository') do |path|
    MultiProfileReviewCycle.generate_config_template(path)
    exit 0
  end

  opts.on('--setup', '--init', 'Setup and onboard current repository for review_cycle (doctor, config, symlinks, gitignore, agents doc)') do
    MultiProfileReviewCycle.run_setup(options)
    exit 0
  end

  opts.on('-v', '--version', 'Show version and exit') do
    puts "review_cycle v#{VERSION}"
    exit 0
  end

  opts.on('--ignore-version', 'Bypass version agreement check between review_cycle and audit') do
    options[:ignore_version] = true
  end

  opts.on('--agents-doc', '--help-agent', 'Print AGENTS.md documentation block for review_cycle and exit') do
    puts MultiProfileReviewCycle.agents_doc
    exit 0
  end

  opts.on('-h', '--help', 'Show this help message') do
    puts opts
    exit 0
  end
end

class MultiProfileReviewCycle
  attr_reader :options, :state, :config_file_path

  def initialize(options)
    @config_file_path = self.class.find_config_file(options[:config])
    config = load_config_file(@config_file_path)
    # CLI options take precedence over config file, which takes precedence over defaults
    @options = config.merge(options.reject { |_k, v| v.nil? })
    @state = load_state
  end

  def self.find_config_file(explicit_path = nil)
    return explicit_path if explicit_path && File.file?(explicit_path)
    return nil if explicit_path

    default_config_paths.find { |p| File.file?(p) }
  end

  def load_config_file(path)
    return {} unless path

    parse_config_file(path)
  end

  def parse_config_file(path)
    parsed = JSON.parse(File.read(path))
    parsed.transform_keys(&:to_sym)
  rescue StandardError => e
    warn "⚠️ Failed to parse config file #{path}: #{e.message}".yellow
    {}
  end

  def check_git_repository!
    return if system('git rev-parse --is-inside-work-tree >/dev/null 2>&1')

    puts "\n❌ [Fatal Error] review-cycle must be executed inside a valid Git repository.".bold.red
    puts "   Initialize git with 'git init' or change into your project repository before running.\n\n"
    exit 1
  end

  def check_config_contract!
    return if options[:dry_run]

    has_config = !@config_file_path.nil?
    has_explicit_gate = (options[:gate_cmd] && !options[:gate_cmd].strip.empty?) ||
                        (ENV['GATE_CMD'] && !ENV['GATE_CMD'].strip.empty?)
    return if has_config || has_explicit_gate

    puts "\n❌ [Config Error] No review_cycle.json configuration found for this repository.".bold.red
    puts "   Autonomous remediation requires a declared verification gate contract."
    puts "\n   To initialize repository configuration:"
    puts "     \e[1mreview-cycle --setup\e[0m"
    puts "\n   Or provide an explicit gate on the command line:"
    puts "     \e[1mreview-cycle --gate-cmd \"cargo test\"\e[0m\n\n"
    exit 1
  end

  def run
    check_git_repository!
    check_config_contract!

    puts "==> review_cycle v#{VERSION}".bold.cyan
    Dir.chdir(REPO_ROOT) do
      if options[:branch]
        bname = options[:branch].is_a?(String) && !options[:branch].empty? ? options[:branch] : "review-cycle/#{Time.now.strftime('%Y%m%d-%H%M%S')}"
        puts "\n==> [Branch Isolation] Switching to feature branch #{bname}...".bold.cyan
        system('git', 'checkout', '-B', bname)
      end

      cycle_count = 0
      clean_profiles = Set.new

      loop do
        cycle_count += 1
        active_profile, p_cand_idx = peek_profile
        model_step, c_cand_idx = peek_model_step(active_profile)

        review_num = next_review_number
        init_cycle_log(review_num, active_profile, model_step)
        print_cycle_header(cycle_count, active_profile, model_step)
        preflight_check

        puts "\n==> Target Review Artifact: #{reports_dir}/#{review_num}_#{active_profile}.md".bold.yellow

        begin
          findings, review_content = run_audit(active_profile, model_step)

          if findings.zero?
            clean_profiles << active_profile
            advance_state(p_cand_idx, c_cand_idx)
            handle_clean_audit(review_num, active_profile, model_step, review_content: review_content)
            break if loop_converged?(clean_profiles, active_profile)
          else
            proceed = handle_defect_audit(review_num, active_profile, model_step, findings, review_content,
                                          p_idx: p_cand_idx, c_idx: c_cand_idx)
            if proceed
              clean_profiles << active_profile
              break if loop_converged?(clean_profiles, active_profile)
            else
              clean_profiles.delete(active_profile)
              break
            end
          end
        ensure
          close_cycle_log
        end

        break unless options[:loop]
        break if cycle_limit_reached?(cycle_count)
      end

      print_loop_summary(cycle_count, clean_profiles) if options[:loop] && cycle_count > 1

      if options[:batch_commits] && options[:loop] && options[:push]
        puts "\n==> [Git] Pushing all batched review loop commits to remote...".bold.cyan
        curr_branch = `git rev-parse --abbrev-ref HEAD`.strip
        system('git', 'push', '--set-upstream', 'origin', curr_branch)
      end
    end
  end

  def print_cycle_header(cycle_count, active_profile, model_step)
    puts "\n" + ('=' * 74).cyan
    puts " 🚀 Starting Review Cycle #{cycle_count} [Lens: #{active_profile.upcase}, #{model_step[:label]}]".bold.cyan
    puts ('=' * 74).cyan
  end

  def handle_clean_audit(review_num, active_profile, model_step, review_content: nil)
    puts "\n🎉 Profile [#{active_profile}] reported 0 defects! Clean bill of health.".bold.green
    record_history(review_num, active_profile, model_step, 0, 'clean', files_edited: 0)
    commit_and_push_cycle(review_num, active_profile, clean: true)
    print_bottom_summary(
      num: review_num, profile: active_profile, model_step: model_step,
      findings: 0, review_content: review_content, footprint: nil, outcome: 'clean'
    )
  end

  def loop_converged?(clean_profiles, active_profile)
    return false unless options[:loop]

    if %w[auto random].include?(options[:profile]) && clean_profiles.size >= AUDIT_PROFILES.size
      puts "\n🌟 COMPLETE CONVERGENCE: All #{AUDIT_PROFILES.size} audit profiles passed with 0 defects!".bold.green
      true
    elsif !%w[auto random].include?(options[:profile]) && clean_profiles.include?(active_profile)
      puts "\n🌟 Profile [#{active_profile}] verified clean with 0 defects!".bold.green
      true
    else
      false
    end
  end

  def cycle_limit_reached?(cycle_count)
    if cycle_count >= options[:max_cycles]
      puts "\nReached maximum cycle count (#{options[:max_cycles]}). Halting loop.".yellow
      true
    else
      false
    end
  end

  def handle_defect_audit(review_num, active_profile, model_step, findings, review_content, p_idx: nil, c_idx: nil)
    puts "\n==> Found #{findings} defect(s). Generating #{reports_dir}/#{review_num}_#{active_profile}.md...".yellow
    save_review_report(review_num, active_profile, model_step, review_content)

    if options[:dry_run]
      puts 'Dry-run enabled. Skipping sandbox remediation.'.yellow
      print_bottom_summary(
        num: review_num, profile: active_profile, model_step: model_step,
        findings: findings, review_content: review_content, footprint: nil, outcome: 'dry_run'
      )
      return false
    end

    report_path = File.join(reports_dir, "#{review_num}_#{active_profile}.md")
    base_sha = `git rev-parse HEAD`.strip
    attempt = 1
    verification_feedback = nil

    loop do
      unless remediate_in_sandbox(review_num, active_profile, feedback: verification_feedback, attempt: attempt)
        rollback_workspace(base_sha, "Sandbox remediation (attempt #{attempt}) failed or was discarded", num: review_num, profile: active_profile)
        record_history(review_num, active_profile, model_step, findings, 'failed_sandbox', files_edited: 0)
        print_bottom_summary(
          num: review_num, profile: active_profile, model_step: model_step,
          findings: findings, review_content: review_content, footprint: nil, outcome: 'failed_sandbox'
        )
        return false
      end

      footprint = check_diff_footprint(base_sha, findings: findings)
      if footprint[:aborted]
        rollback_workspace(base_sha, footprint[:reason], num: review_num, profile: active_profile)
        record_history(review_num, active_profile, model_step, findings, 'rejected_diff', files_edited: 0)
        print_bottom_summary(
          num: review_num, profile: active_profile, model_step: model_step,
          findings: findings, review_content: review_content, footprint: nil, outcome: 'rejected_diff'
        )
        return false
      end

      if footprint[:false_positive]
        puts "\nℹ️ Zero code changes detected: remediation agent triaged findings as false positives.".cyan
        advance_state(p_idx, c_idx)
        archive_artifacts(review_num) unless options[:keep_reviews]
        record_history(review_num, active_profile, model_step, findings, 'false_positive_triage', files_edited: 0)
        commit_and_push_cycle(review_num, active_profile, clean: true)
        print_bottom_summary(
          num: review_num, profile: active_profile, model_step: model_step,
          findings: findings, review_content: review_content, footprint: footprint, outcome: 'false_positive_triage'
        )
        return true
      end

      unless verify_quality_gate
        rollback_workspace(base_sha, "Post-merge quality gate verification failed (attempt #{attempt})", num: review_num, profile: active_profile)
        record_history(review_num, active_profile, model_step, findings, 'failed_gate', files_edited: 0)
        print_bottom_summary(
          num: review_num, profile: active_profile, model_step: model_step,
          findings: findings, review_content: review_content, footprint: nil, outcome: 'failed_gate'
        )
        return false
      end

      reinstall_binary

      # Phase 4: Targeted Re-Verification Pass
      verification = if options[:skip_diff_audit]
                       { passed: true, remaining: 0, output: 'Diff verification skipped by flag', details: 'Skipped' }
                     else
                       run_targeted_verification(active_profile, report_path, base_sha, model_step)
                     end

      if verification[:passed]
        puts "\n✓ Targeted verification PASSED: Auditor confirmed defects resolved with 0 regressions.".bold.green
        summary_content = generate_post_work_summary(review_num, active_profile, model_step, findings,
                                                      footprint: footprint, diff_audit: verification)
        output_summary(review_num, summary_content)
        advance_state(p_idx, c_idx)
        archive_artifacts(review_num) unless options[:keep_reviews]
        record_history(review_num, active_profile, model_step, findings, 'remediated',
                       files_edited: footprint[:files]&.size)
        commit_and_push_cycle(review_num, active_profile)

        puts "\n✅ Review Cycle #{review_num} (#{active_profile}) verified, completed and archived!".bold.green
        print_bottom_summary(
          num: review_num, profile: active_profile, model_step: model_step,
          findings: findings, review_content: review_content, footprint: footprint, outcome: 'remediated'
        )
        return true
      end

      # Verification failed
      attempt += 1
      if attempt > 2
        rollback_workspace(base_sha, "Targeted verification failed to converge after 2 attempts: #{verification[:details]}", num: review_num, profile: active_profile)
        record_history(review_num, active_profile, model_step, findings, 'blocked', files_edited: 0)
        print_bottom_summary(
          num: review_num, profile: active_profile, model_step: model_step,
          findings: findings, review_content: review_content, footprint: footprint, outcome: 'blocked'
        )
        return false
      end

      warn_msg = "\n⚠️ Targeted verification failed (attempt 1/2). Re-attempting remediation with auditor feedback..."
      puts warn_msg.bold.yellow
      log_write("#{warn_msg}\n")
      verification_feedback = verification[:output]
    end
  end

  def init_cycle_log(num, profile, model_step)
    ldir = logs_dir
    FileUtils.mkdir_p(ldir)
    @current_log_path = File.join(ldir, "review_#{num}_#{profile}.log")
    @log_file&.close rescue nil
    @log_file = File.open(@current_log_path, 'a')
    @log_file.sync = true

    latest_path = File.join(ldir, 'latest.log')
    File.delete(latest_path) if File.exist?(latest_path) || File.symlink?(latest_path)
    File.symlink(@current_log_path, latest_path) rescue nil

    log_write("=== Review Cycle #{num} [Lens: #{profile}, Model: #{model_step[:label]}] Started at #{Time.now.utc.iso8601} ===\n")
    puts "==> Execution Log: #{@current_log_path}".cyan
  end

  def log_write(str)
    return unless @log_file

    clean_str = str.gsub(/\e\[[0-9;]*[mK]/, '')
    @log_file.write(clean_str)
  end

  def close_cycle_log
    return unless @log_file

    log_write("=== Review Cycle Log Finished at #{Time.now.utc.iso8601} ===\n\n")
    @log_file.close rescue nil
    @log_file = nil
  end

  def rollback_workspace(base_sha, reason, num: nil, profile: nil)
    current_sha = `git rev-parse HEAD 2>/dev/null`.strip
    if !current_sha.empty? && current_sha != base_sha
      suffix = "#{num || 'unknown'}_#{profile || 'cycle'}_#{Time.now.strftime('%Y%m%d_%H%M%S')}"
      failed_branch = "reviews/failed_#{suffix}"
      Open3.capture3("git branch #{failed_branch} #{current_sha}")
      save_msg = "\n💾 [Preservation] Preserved failed remediation commits on branch: #{failed_branch}"
      puts save_msg.bold.cyan
      log_write("#{save_msg}\n")
    end

    msg = "\n⚠️ [Rollback] #{reason}. Reverting workspace to #{base_sha[0..8]}..."
    puts msg.bold.red
    log_write("#{msg}\n")
    system('git', 'reset', '--hard', base_sha)
    system('git', 'clean', '-fd')
    done_msg = "Workspace rolled back cleanly to #{base_sha[0..8]}."
    puts done_msg.yellow
    log_write("#{done_msg}\n")
  end

  # Language & Framework Helpers
  def detect_project_language
    pname = File.basename(REPO_ROOT)
    if File.exist?(File.join(REPO_ROOT, 'go.mod'))
      :go
    elsif File.exist?(File.join(REPO_ROOT, 'Cargo.toml'))
      :rust
    elsif File.exist?(File.join(REPO_ROOT, 'Gemfile')) || File.exist?(File.join(REPO_ROOT, '.rubocop.yml'))
      :ruby
    elsif Dir.exist?(File.join(REPO_ROOT, 'lib', pname))
      :ruby
    elsif Dir.glob(File.join(REPO_ROOT, '**', '*.go')).any?
      :go
    elsif Dir.glob(File.join(REPO_ROOT, '**', '*.rs')).any?
      :rust
    elsif Dir.glob(File.join(REPO_ROOT, '**', '*.rb')).any?
      :ruby
    else
      :generic
    end
  end

  def target_directory
    return options[:target] if options[:target] && !options[:target].strip.empty?
    return ENV['AUDIT_TARGET'] if ENV['AUDIT_TARGET'] && !ENV['AUDIT_TARGET'].strip.empty?

    lang = detect_project_language
    if lang == :rust && Dir.exist?(File.join(REPO_ROOT, 'src'))
      'src/'
    elsif lang == :ruby && Dir.exist?(File.join(REPO_ROOT, 'lib'))
      pname = File.basename(REPO_ROOT)
      bin_file = [File.join(REPO_ROOT, pname), File.join(REPO_ROOT, 'bin', pname), File.join(REPO_ROOT, 'exe', pname)].find { |f| File.file?(f) }
      bin_file ? "lib #{bin_file.sub(%r{^#{Regexp.escape(REPO_ROOT)}/}, '')}" : 'lib/'
    else
      '.'
    end
  end

  def reports_dir
    @reports_dir ||= begin
      if options[:reports_dir] && !options[:reports_dir].strip.empty?
        options[:reports_dir]
      elsif Dir.exist?(File.join(REPO_ROOT, 'reviews'))
        'reviews'
      elsif Dir.exist?(File.join(REPO_ROOT, 'reports'))
        'reports'
      else
        'reviews'
      end
    end
  end

  def logs_dir
    File.join(REPO_ROOT, reports_dir, 'logs')
  end

  def archive_dir
    File.join(REPO_ROOT, reports_dir, 'archive')
  end

  def guideline_instructions
    hints = []
    hints << options[:guidelines] if options[:guidelines] && !options[:guidelines].strip.empty?

    lang = detect_project_language
    case lang
    when :go
      hints << 'Adhere strictly to ~/prog/standards/go/GUIDELINES.md and go-audit (cognitive complexity <= 15, depth <= 4, tiered sizing <= 110 lines standard, no else after return)'
    when :rust
      hints << 'Adhere strictly to ~/prog/standards/rust/GUIDELINES.md and rust-audit (cognitive complexity <= 15, depth <= 4, method length <= 80 lines, avoid unwrap in library code)'
    when :ruby
      hints << 'Adhere strictly to ~/prog/standards/ruby/GUIDELINES.md and ruby-audit (cognitive complexity <= 15, depth <= 4, method length <= 80 lines, avoid rescue Exception)'
    end

    agents_file = File.join(REPO_ROOT, 'AGENTS.md')
    claude_file = File.join(REPO_ROOT, 'CLAUDE.md')
    audit_code_file = [File.join(REPO_ROOT, 'tools', 'gate_audit_code'), File.join(REPO_ROOT, 'tools', 'audit_code')].find { |f| File.exist?(f) }

    if File.exist?(agents_file)
      content = File.read(agents_file)
      hints << (content.include?('80 lines') ? 'Adhere strictly to AGENTS.md (<= 80 lines per function, decompose in place)' : 'Adhere strictly to all guidelines in AGENTS.md')
    elsif File.exist?(claude_file)
      hints << 'Adhere strictly to all guidelines in CLAUDE.md'
    end

    if audit_code_file && !options[:guidelines]
      tool_name = File.basename(audit_code_file)
      hints << "Adhere strictly to tools/#{tool_name} (method length <= 80 lines, cognitive complexity <= 15, depth <= 4)"
    end

    hints.empty? ? '' : " #{hints.join('. ')}."
  end

  def candidate_gate_commands
    [
      File.join(REPO_ROOT, 'tools', 'gate'),
      File.join(REPO_ROOT, 'tools', 'test_light'),
      File.join(REPO_ROOT, 'tools', 'gate.sh'),
      File.join(REPO_ROOT, 'tools', 'check'),
      File.join(REPO_ROOT, 'tools', 'check.rb'),
      File.join(REPO_ROOT, 'gate'),
      File.join(REPO_ROOT, 'check'),
      File.expand_path('gate', __dir__),
      File.expand_path('check', __dir__),
      File.expand_path('check.rb', __dir__)
    ]
  end

  def language_gate_command
    case detect_project_language
    when :rust then File.exist?(File.join(REPO_ROOT, 'Cargo.toml')) ? 'cargo test' : nil
    when :go   then File.exist?(File.join(REPO_ROOT, 'go.mod')) ? 'go test ./...' : nil
    when :ruby then Dir.exist?(File.join(REPO_ROOT, 'test')) ? 'ruby -I. test/test_*.rb' : nil
    end
  end

  def resolve_gate_cmd
    return options[:gate_cmd] if options[:gate_cmd] && !options[:gate_cmd].strip.empty?
    return ENV['GATE_CMD'] if ENV['GATE_CMD'] && !ENV['GATE_CMD'].strip.empty?

    candidate = candidate_gate_commands.find { |p| File.file?(p) && (File.executable?(p) || p.end_with?('.rb')) }
    return candidate.end_with?('.rb') && !File.executable?(candidate) ? "ruby #{candidate}" : candidate if candidate

    makefile = File.join(REPO_ROOT, 'Makefile')
    return 'make check' if File.file?(makefile) && File.read(makefile).match?(/^\s*check\s*:/)

    language_gate_command
  end

  def resolve_audit_executable
    return options[:audit_cmd] if options[:audit_cmd] && !options[:audit_cmd].strip.empty?
    return ENV['AUDIT_CMD'] if ENV['AUDIT_CMD'] && !ENV['AUDIT_CMD'].strip.empty?

    candidates = [
      File.join(REPO_ROOT, 'tools', 'audit'),
      File.join(REPO_ROOT, 'tools', 'audit.rb'),
      File.expand_path('audit', __dir__),
      File.expand_path('audit.rb', __dir__),
      File.join(REPO_ROOT, 'audit'),
      File.join(REPO_ROOT, 'audit.rb'),
      `which audit 2>/dev/null`.strip,
      `which agy_audit 2>/dev/null`.strip
    ]
    candidates.find do |c|
      next false if c.nil? || c.empty?

      File.exist?(c) && (File.executable?(c) || c.end_with?('.rb'))
    end
  end

  def safe_install_script?(path)
    return false unless File.file?(path) && (File.executable?(path) || path.end_with?('.rb'))

    content = File.read(path) rescue ''
    !content.include?('git commit') && !content.include?('git push')
  end

  def language_build_command
    case detect_project_language
    when :rust then File.exist?(File.join(REPO_ROOT, 'Cargo.toml')) ? 'cargo build --release' : nil
    when :go   then File.exist?(File.join(REPO_ROOT, 'go.mod')) ? 'go build .' : nil
    end
  end

  def resolve_build_cmd
    return options[:build_cmd] if options[:build_cmd] && !options[:build_cmd].strip.empty?
    return ENV['BUILD_CMD'] if ENV['BUILD_CMD'] && !ENV['BUILD_CMD'].strip.empty?

    build_candidates = [
      File.join(REPO_ROOT, 'tools', 'build_local'),
      File.join(REPO_ROOT, 'tools', 'build_local.rb'),
      File.join(REPO_ROOT, 'tools', 'install'),
      File.join(REPO_ROOT, 'tools', 'install.rb'),
      File.expand_path('build_local', __dir__),
      File.expand_path('build_local.rb', __dir__),
      File.expand_path('install', __dir__)
    ]
    candidate = build_candidates.find { |p| safe_install_script?(p) || (File.file?(p) && File.executable?(p)) }
    return candidate.end_with?('.rb') && !File.executable?(candidate) ? "ruby #{candidate}" : candidate if candidate

    makefile = File.join(REPO_ROOT, 'Makefile')
    return 'make build' if File.file?(makefile) && File.read(makefile).match?(/^\s*build\s*:/)

    language_build_command
  end

  private

  def state_file_path
    @state_file_path ||= self.class.state_file_path(reports_dir)
  end

  def load_state
    target = state_file_path
    if File.exist?(target)
      JSON.parse(File.read(target))
    else
      migrate_or_init_state(target)
    end
  rescue StandardError
    default_empty_state
  end

  def migrate_or_init_state(target)
    legacy = [File.join(REPO_ROOT, '.review_state.json'), File.join(REPO_ROOT, 'review_state.json')].find { |f| File.exist?(f) }
    if legacy
      data = JSON.parse(File.read(legacy)) rescue nil
      if data
        FileUtils.mkdir_p(File.dirname(target))
        File.write(target, JSON.pretty_generate(data))
        FileUtils.rm_f(legacy)
        return data
      end
    end
    default_empty_state
  end

  def default_empty_state
    { 'last_profile_index' => -1, 'last_cadence_index' => -1, 'history' => [] }
  end

  def save_state
    FileUtils.mkdir_p(File.dirname(state_file_path))
    File.write(state_file_path, JSON.pretty_generate(@state))
  end

  def peek_profile
    case options[:profile]
    when 'random'
      chosen = AUDIT_PROFILES.sample
      puts "Profile selected randomly: #{chosen}".magenta
      [chosen, nil]
    when 'auto'
      next_idx = ((state['last_profile_index'] || -1) + 1) % AUDIT_PROFILES.size
      chosen = AUDIT_PROFILES[next_idx]
      puts "Profile candidate via Round-Robin: #{chosen} (profile #{next_idx + 1}/#{AUDIT_PROFILES.size})".magenta
      [chosen, next_idx]
    else
      prof = AUDIT_PROFILES.include?(options[:profile]) ? options[:profile] : 'systems'
      [prof, nil]
    end
  end

  def peek_model_step(active_profile = nil)
    if options[:backend] || options[:tier]
      backend = options[:backend] || 'auto'
      tier = options[:tier] || 'standard'
      label = "Manual Override (#{backend.upcase}/#{tier.upcase})"
      puts "Model selection overridden: #{label}".magenta
      return [{ tier: tier, backend: backend, label: label }, nil]
    end

    if options[:cadence] == 'pyramid'
      next_idx = ((state['last_cadence_index'] || -1) + 1) % MODEL_CADENCE.size
      step = MODEL_CADENCE[next_idx]
      puts "Model candidate via 4:2:1 Cadence: #{step[:label]} [Cadence Step #{next_idx + 1}/#{MODEL_CADENCE.size}]".magenta
      return [step, next_idx]
    end

    prof = active_profile || 'systems'
    backend = case prof
              when 'systems', 'performance' then 'codex'
              else 'claude'
              end
    tier = 'standard'
    label = "#{backend.capitalize} (Tier 1 Standard [#{prof}])"
    puts "Model selection via Profile Affinity: #{label}".magenta
    [{ tier: tier, backend: backend, label: label }, nil]
  end

  def advance_state(p_idx, c_idx)
    state['last_profile_index'] = p_idx if p_idx
    state['last_cadence_index'] = c_idx if c_idx
    save_state if p_idx || c_idx
  end

  def run_quality_gate(label)
    cmd = resolve_gate_cmd
    unless cmd
      warn "⚠️ [#{label}] No quality gate detected (use --gate-cmd or --skip-gate). Skipping gate.".yellow
      return true
    end

    puts "==> [#{label}] Running Quality Gate (#{cmd})...".cyan
    log_write("==> [#{label}] Running Quality Gate (#{cmd})...\n")
    success = false
    Open3.popen2e(cmd) do |stdin, stdout_err, wait_thr|
      stdin.close rescue nil
      while (line = stdout_err.gets)
        print line
        log_write(line)
      end
      success = wait_thr.value&.success? || false
    end
    log_write("--> Quality Gate [#{label}] #{success ? 'PASSED' : 'FAILED'}\n")
    success
  end

  def fetch_auditor_version(audit_bin)
    out, status = Open3.capture2(audit_bin, '--version')
    return nil unless status.success?

    out[/v?(\d+\.\d+\.\d+)/, 1]
  rescue StandardError
    nil
  end

  def verify_auditor_version
    return if options[:ignore_version]

    audit_bin = resolve_audit_executable
    unless audit_bin
      puts '❌ Could not find audit executable (checked tools/audit, ./audit, $PATH).'.bold.red
      exit 1
    end

    auditor_ver = fetch_auditor_version(audit_bin)
    return warn "⚠️ Warning: #{audit_bin} did not report a version via --version.".yellow unless auditor_ver

    if auditor_ver != VERSION
      err = "❌ Version mismatch: review_cycle is v#{VERSION}, but #{audit_bin} is v#{auditor_ver}.\n" \
            "   Versions must agree for reliable operation (bypass with --ignore-version)."
      puts err.bold.red
      log_write("#{err}\n")
      exit 1
    end

    puts "  ✓ Auditor verified: #{audit_bin} (v#{auditor_ver}) matches review_cycle (v#{VERSION})".green
  end

  def preflight_check
    status = `git status --porcelain`.strip
    unless status.empty?
      puts '==> Checkpointing uncommitted tracked changes before review cycle...'.yellow
      system('git', 'add', '-u')
      system('git', 'commit', '--no-verify', '-m', 'wip: pre-review-cycle checkpoint')
    end

    verify_auditor_version

    return if options[:skip_gate]

    unless run_quality_gate('Pre-flight')
      puts '❌ Baseline quality gate failed. Aborting cycle.'.bold.red
      exit 1
    end
  end

  def next_review_number
    arch_path = archive_dir
    archive_files = Dir.glob(File.join(arch_path, '*.md'))
    archive_numbers = archive_files.map do |f|
      File.basename(f) =~ /^(\d+)/ ? Regexp.last_match(1).to_i : nil
    end.compact
    max_archived = archive_numbers.max || 0

    active_files = Dir.glob(File.join(reports_dir, '*.md'))
    active_numbers = active_files.map do |f|
      File.basename(f) =~ /^(\d+)/ ? Regexp.last_match(1).to_i : nil
    end.compact

    history_numbers = (state['history'] || []).map { |h| h['number'].to_i }.compact
    max_history = history_numbers.max || 0

    highest_known = [max_archived, max_history].max

    next_id = if active_numbers.include?(highest_known + 1)
                highest_known + 1
              else
                [highest_known, active_numbers.max || 0].max + 1
              end

    format('%03d', next_id)
  end

  def resolve_audit_cmd(profile, model_step)
    audit_bin = resolve_audit_executable
    unless audit_bin
      puts '❌ Could not find audit executable (checked tools/audit, ./audit, $PATH).'.bold.red
      exit 1
    end

    audit_bin.split + [
      '-p', profile,
      '-b', model_step[:backend],
      '-t', model_step[:tier]
    ] + target_directory.split
  end

  def transient_error?(output, exit_status)
    return true if exit_status == 429 || exit_status == 503

    output.match?(/429|rate\s*limit|overloaded|502|503|504|timeout|connection\s*reset|network\s*error/i)
  end

  def execute_audit_attempt(cmd)
    output = String.new
    status = nil
    Open3.popen2e(*cmd) do |stdin, stdout_err, wait_thr|
      stdin.close rescue nil
      while (line = stdout_err.gets)
        print line
        output << line
        log_write(line)
      end
      status = wait_thr.value
    end
    [output, status]
  end

  def run_audit_process(cmd, max_retries = 3)
    attempt = 0
    loop do
      attempt += 1
      output, status = execute_audit_attempt(cmd)
      return [output, status] if status&.success?
      return [output, status] if attempt >= max_retries || !transient_error?(output, status&.exitstatus)

      delay = (2**attempt) + rand(0.5..1.5)
      warn_msg = "\n⚠️ Transient audit failure (attempt #{attempt}/#{max_retries}). Retrying in #{delay.round(1)}s..."
      puts warn_msg.bold.yellow
      log_write("#{warn_msg}\n")
      sleep delay
    end
  end

  def count_audit_findings(output)
    return 0 if output.nil? || output.empty?

    if output =~ /NO\s+(?:CRITICAL\s+)?DEFECTS\s+FOUND/i && output.scan(/^\s*\[LOCATION\]:/i).empty?
      return 0
    end

    breakdown = extract_severity_breakdown(output)
    breakdown.values.sum
  end

  def run_audit(profile, model_step)
    msg = "\n==> [Phase 1/5] Running Adversarial Audit [Lens: #{profile}, Model: #{model_step[:label]}]..."
    puts msg.bold.cyan
    log_write("#{msg}\n")
    cmd = resolve_audit_cmd(profile, model_step)
    log_write("--> Audit command: #{cmd.join(' ')}\n")

    output, status = run_audit_process(cmd)
    log_write("--> Audit process exit status: #{status&.exitstatus}\n")

    unless status&.success?
      err_msg = "\n❌ Audit failed with exit code #{status&.exitstatus || 'unknown'}. Aborting cycle."
      puts err_msg.bold.red
      log_write("#{err_msg}\n")
      exit(status&.exitstatus || 1)
    end

    findings = count_audit_findings(output)
    log_write("--> Findings detected: #{findings}\n")
    [findings, output]
  end

  def save_review_report(num, profile, model_step, output)
    FileUtils.mkdir_p(reports_dir)
    report_path = File.join(reports_dir, "#{num}_#{profile}.md")

    content = if output.include?('# Systems Code Review Report')
                output
              else
                <<~MARKDOWN
                  # Systems Code Review Report ##{num} (Lens: #{profile})

                  - **Date**: #{Date.today.strftime('%Y-%m-%d')}
                  - **Auditor**: #{model_step[:label]} via `tools/audit`
                  - **Focus Lens**: `#{profile}`
                  - **Model Tier**: `#{model_step[:tier].upcase}`
                  - **Backend**: `#{model_step[:backend]}`
                  - **Scope**: `#{target_directory}`
                  - **Status**: Action Required

                  ---

                  #{output.strip}
                MARKDOWN
              end

    File.write(report_path, content)
    log_write("--> Saved review report: #{report_path}\n")
    unless options[:dry_run]
      system('git', 'add', report_path, state_file_path)
      system('git', 'commit', '-m', "docs: add code review report #{num} (#{profile} via #{model_step[:label]})")
      log_write("--> Committed review report and #{state_file_path}\n")
    end
  end

  def recent_mitigations_context(limit = 3)
    history = (@state['history'] || []).select { |h| h['outcome'] == 'remediated' }
    return '' if history.empty?

    recent = history.last(limit)
    lines = ["RECENT REMEDIATIONS (Anti-Oscillation Ledger — do NOT revert or weaken architectural safeguards, defensive copying, or error wrappers introduced in these rounds):"]
    recent.each do |h|
      lines << "- Round #{h['number']} (#{h['profile']}): fixed #{h['findings']} issue(s) via #{h['model']}"
    end
    lines.join(' ')
  end

  def remediate_prompt(profile, plan_path, report_path, summary_path, feedback: nil, attempt: 1)
    gate_note = resolve_gate_cmd ? " and verify with #{resolve_gate_cmd}" : ''
    guide_note = guideline_instructions
    anti_oscillation = recent_mitigations_context
    oscillation_note = anti_oscillation.empty? ? '' : " 5. Anti-Oscillation: #{anti_oscillation}"
    feedback_note = feedback ? " 6. Verification Feedback (Attempt #{attempt}): Previous verification pass reported: #{feedback}. Fix these remaining issues and ensure regression test validates them." : ''

    <<~PROMPT.strip.gsub(/\s+/, ' ')
      /goal Create an architectural plan in #{plan_path} addressing genuine defects from #{report_path},
      implement fixes across the codebase, and verify all quality checks pass cleanly. Focus area: #{profile} audit.
      INVARIANTS:
      1. Triage First: Evaluate each finding in #{report_path}. If all findings are invalid false positives
      or intentional design behavior, document the technical rationale in #{plan_path} and summary without modifying code or tests.
      2. Targeted Fixes & Mandatory Tests: For each genuine defect, implement the minimal, idiomatic fix and add or update at least
      one regression unit test validating the fix. If code is modified, regression tests are strictly mandatory. Keep changes scoped strictly to the reported issues.
      3. Quality Gate & Metrics: Run `tools/gate`#{gate_note} frequently and ensure all tests pass.
      Every new or modified method MUST satisfy code metrics: method length <= 80 lines (or <= 120 lines if cognitive complexity <= 5),
      cognitive complexity <= 15, and nesting depth <= 4.#{guide_note}
      4. Scope Containment: Do not refactor unaffected modules or modify external CLI behavior unless required by the report.#{oscillation_note}#{feedback_note}
      Save plan to #{plan_path}, author post-work summary to #{summary_path} (stating issue, status/mitigation, and verification),
      and commit all work when complete.
    PROMPT
  end

  def remediate_in_sandbox(num, profile, feedback: nil, attempt: 1)
    branch = "fix-review-#{num}-#{profile}-remediation"
    branch += "-try#{attempt}" if attempt > 1
    plan_path = "#{reports_dir}/#{num}_#{profile}_plan.md"
    report_path = "#{reports_dir}/#{num}_#{profile}.md"
    summary_path = "#{reports_dir}/#{num}_summary.md"
    prompt = remediate_prompt(profile, plan_path, report_path, summary_path, feedback: feedback, attempt: attempt)

    msg = "\n==> [Phase 2/5] Dispatching Sandbox Agent via bws gw on branch #{branch} (Attempt #{attempt})..."
    puts msg.bold.cyan
    log_write("#{msg}\n")

    cmd = [
      'bws', 'gw', '--allow-dirty', '-b', branch, '--',
      'agy-run-wild', '--effort', options[:effort],
      '-p', prompt
    ]

    success = run_with_auto_triage(cmd)
    unless success
      err_msg = "❌ Sandbox execution failed or was discarded. Full log: #{@current_log_path}"
      puts err_msg.bold.red
      log_write("#{err_msg}\n")
    end
    success
  end

  def check_squash_prompt(buffer, stdin, responded)
    return responded if responded || !buffer.include?('What would you like to do with branch')

    auto_msg = "\n[tools/review_cycle] Auto-selecting [s] Squash-merge...\n"
    puts auto_msg.bold.green
    log_write(auto_msg)
    stdin.write("s\n")
    stdin.flush
    true
  end

  def stream_pty_output(stdout, stdin)
    buffer = String.new
    responded = false
    while (char = stdout.getc)
      print char
      $stdout.flush
      log_write(char)
      buffer << char
      buffer = buffer[-300..] if buffer.length > 600
      responded = check_squash_prompt(buffer, stdin, responded)
    end
  rescue Errno::EIO
    # Normal process completion
  end

  def kill_pty_process(pid)
    Process.kill('TERM', pid) rescue nil
    sleep 0.2
    Process.kill('KILL', pid) rescue nil
  end

  def run_with_auto_triage(cmd_args)
    status = nil
    log_write("--> Spawning PTY: #{cmd_args.join(' ')}\n")

    PTY.spawn(*cmd_args) do |stdout, stdin, pid|
      begin
        stream_pty_output(stdout, stdin)
      rescue Interrupt, SignalException => e
        kill_pty_process(pid)
        raise e
      ensure
        _, status = Process.wait2(pid) rescue [nil, nil]
      end
    end

    exit_code = status&.exitstatus || (status&.success? ? 0 : 1)
    log_write("--> Sandbox PTY exited with status: #{exit_code}\n")
    status&.success? || false
  end

  def check_diff_footprint(base_sha, findings: 0)
    stat_str = `git diff --shortstat #{base_sha}..HEAD`.strip
    file_list = `git diff --name-only #{base_sha}..HEAD`.lines.map(&:strip).reject(&:empty?)

    puts "\n==> Inspecting Remediation Footprint...".cyan
    puts "  Files modified: #{file_list.size} file(s)"
    puts "  Diff stat: #{stat_str.empty? ? 'No changes' : stat_str}"

    if file_list.empty? || stat_str.empty?
      return { aborted: false, files: [], total_lines: 0, test_files: [], stat: 'No changes', false_positive: true }
    end

    diff_text = `git diff #{base_sha}..HEAD`
    lang = detect_project_language

    test_files = file_list.select do |f|
      case lang
      when :go
        f.end_with?('_test.go')
      when :rust
        f.start_with?('tests/') || f.end_with?('_test.rs') || f == 'src/tests.rs'
      when :ruby
        f.start_with?('test/') || f.start_with?('spec/') || f =~ /_(?:test|spec)\.rb$/ || f =~ /^test_.*\.rb$/
      else
        f =~ /test/i || f =~ /spec/i
      end
    end

    inline_tests = false
    case lang
    when :rust
      inline_tests = diff_text.lines.any? { |l| l =~ /^\+\s*(?:#\[cfg\(test\)\]|#\[test\])/ }
    when :ruby
      inline_tests = diff_text.lines.any? { |l| l =~ /^\+\s*(?:def\s+test_|it\s+["']|describe\s+["'])/ }
    when :go
      inline_tests = diff_text.lines.any? { |l| l =~ /^\+\s*func\s+Test[A-Z]/ }
    end

    if test_files.any? || inline_tests
      test_desc = test_files.any? ? test_files.join(', ') : 'Inline test module/cases in diff'
      puts "  ✓ Regression test(s) modified/added: #{test_desc}".green
    else
      msg = 'No regression test files or test blocks modified in this cycle.'
      warn "  ⚠️ Warning: #{msg}".yellow
      if options[:strict_tests] || findings.to_i > 0
        return { aborted: true, reason: "Remediation rejected: #{msg} (automated regression tests are mandatory for reported findings)" }
      end
    end

    # Test-Weakening & Assertion Atrophy Guard
    test_weakening_notices = []
    skip_pattern = case lang
                   when :go   then /^\+\s*\bt\.(?:Skip|Skipf|SkipNow)\(/
                   when :rust then /^\+\s*#\[ignore(?:\s*=.*)?\]/
                   when :ruby then /^\+\s*(?:\bskip\b|\bxit\b|\bpending\b)/
                   else /^\+\s*(?:#\[ignore\]|\bt\.Skip\(|\bskip\b)/
                   end

    diff_text.lines.each do |dl|
      if dl =~ skip_pattern
        test_weakening_notices << "Introduced test skip/ignore: #{dl.strip}"
      end
    end

    assert_pattern = case lang
                     when :rust then /(?:assert!|assert_eq!|assert_ne!|debug_assert!)/
                     when :go   then /(?:assert\.|require\.|t\.(?:Error|Fatal|Fail))/
                     when :ruby then /(?:assert|refute|expect\()/
                     else /(?:assert|expect|refute)/
                     end

    deleted_asserts = diff_text.lines.select { |l| l =~ /^\-\s*#{assert_pattern}/ }.size
    added_asserts = diff_text.lines.select { |l| l =~ /^\+\s*#{assert_pattern}/ }.size
    if deleted_asserts > 2 && added_asserts < (deleted_asserts / 2)
      test_weakening_notices << "Assertion deficit: deleted #{deleted_asserts} assertion(s) but added only #{added_asserts}"
    end

    if test_weakening_notices.any?
      puts "\n  ⚠️ Test-Weakening Detected:".bold.yellow
      test_weakening_notices.each { |w| puts "    • #{w}".yellow }
      log_write("⚠️ Test-weakening notices: #{test_weakening_notices.join('; ')}\n")
      return { aborted: true, reason: "Test-weakening rejected: #{test_weakening_notices.first}" }
    end

    insertions = stat_str[/(\d+)\s+insertion/, 1].to_i
    deletions = stat_str[/(\d+)\s+deletion/, 1].to_i
    total_lines = insertions + deletions

    max_lines = options[:max_diff_lines] || 800
    if total_lines > max_lines
      msg = "Diff footprint (#{total_lines} lines) exceeds threshold (#{max_lines} lines)"
      if options[:strict_diff]
        return { aborted: true, reason: msg }
      else
        warn "  ⚠️ Warning: #{msg}.".yellow
      end
    end

    { aborted: false, files: file_list, total_lines: total_lines, test_files: test_files, stat: stat_str, false_positive: false }
  end

  def run_targeted_verification(profile, report_path, base_sha, model_step)
    diff = `git diff #{base_sha}..HEAD`
    if diff.strip.empty?
      return { passed: true, remaining: 0, output: 'No code changes in diff', details: 'Clean triage' }
    end

    audit_bin = resolve_audit_executable
    unless audit_bin
      warn '  ⚠️ Audit executable not found for targeted verification. Skipping verification pass.'.yellow
      return { passed: true, remaining: 0, output: 'Auditor missing', details: 'Auditor missing' }
    end

    puts "\n==> [Phase 4/5] Running Targeted Re-Verification Pass [Lens: #{profile}, #{model_step[:label]}]...".bold.cyan
    log_write("==> [Phase 4/5] Running Targeted Re-Verification Pass [Lens: #{profile}]...\n")

    cmd = audit_bin.split + ['-p', profile, '-V', report_path]
    cmd += ['-t', model_step[:tier]] if model_step[:tier]
    cmd += ['-b', model_step[:backend]] if model_step[:backend] && model_step[:backend] != 'auto'

    output = String.new
    status = nil

    Open3.popen2e(*cmd) do |stdin, stdout_err, wait_thr|
      stdin.write(diff)
      stdin.close rescue nil
      while (line = stdout_err.gets)
        print line
        output << line
        log_write(line)
      end
      status = wait_thr.value
    end

    passed = status&.success? || (output =~ /\[VERIFICATION\]:\s*PASSED/i && output !~ /\[VERIFICATION\]:\s*FAILED/i)
    remaining = output[/\[REMAINING DEFECTS\]:\s*(\d+)/i, 1]&.to_i || (passed ? 0 : 1)
    details = if passed
                'All reported findings resolved with 0 regressions.'
              else
                output[/\[UNRESOLVED FINDINGS\]:\s*([^\n]+)/i, 1] || output[/\[FAILURE DETAILS\]:\s*([^\n]+)/i, 1] || 'Unresolved defects in patch'
              end

    { passed: passed && remaining.zero?, remaining: remaining, output: output, details: details }
  rescue StandardError => e
    warn "  ⚠️ Targeted verification error: #{e.message}".yellow
    { passed: false, remaining: 1, output: e.message, details: e.message }
  end

  def verify_quality_gate
    puts "\n==> [Phase 3/5] Verifying Post-Merge Quality Gate...".bold.cyan
    if run_quality_gate('Post-merge')
      puts 'Quality gate passed.'.green
      true
    else
      puts '❌ Post-merge quality gate failed!'.bold.red
      false
    end
  end

  def reinstall_binary
    cmd = resolve_build_cmd
    return unless cmd

    puts "\n==> Rebuilding binary via #{cmd}...".cyan
    system(cmd)
  end

  def generate_post_work_summary(num, profile, model_step, findings, footprint: nil, diff_audit: nil)
    FileUtils.mkdir_p(reports_dir)
    root_summary = "#{num}_summary.md"
    summary_path = "#{reports_dir}/#{num}_summary.md"

    FileUtils.mv(root_summary, summary_path) if File.exist?(root_summary) && !File.exist?(summary_path)

    content = if File.exist?(summary_path) && !File.read(summary_path).strip.empty?
                append_summary_metadata(File.read(summary_path), footprint, diff_audit)
              else
                build_summary(num, profile, model_step, findings, footprint: footprint, diff_audit: diff_audit)
              end

    File.write(summary_path, content)
    system('git', 'add', summary_path)
    system('git', 'commit', '-m', "docs: add post-work summary #{num} (#{profile})")
    content
  end

  def append_summary_metadata(content, footprint, diff_audit)
    lines = content.lines
    meta_idx = lines.rindex { |l| l =~ /^\s*-\s*\*\*/ }
    return content unless meta_idx

    extra = []
    if footprint && footprint[:stat] && !footprint[:stat].empty? && !content.include?('**Footprint**')
      extra << "- **Footprint**: #{footprint[:stat]}\n"
    end
    if diff_audit && !content.include?('**Differential Audit**')
      label = diff_audit[:findings].zero? ? 'Clean (0 defects in diff)' : "#{diff_audit[:findings]} warning(s)"
      extra << "- **Differential Audit**: #{label}\n"
    end

    lines.insert(meta_idx + 1, *extra).join
  end

  def output_summary(num, _content)
    puts "\n==> [Phase 4/5] Post-Work Summary authored: #{reports_dir}/#{num}_summary.md".bold.cyan
  end

  def extract_issue_blocks(content)
    return [] if content.nil? || content.empty?

    sep_regex = /(?=\n\s*(?:\[SEVERITY\]:?|\[(?:CRITICAL|MAJOR|MODERATE|SEVERE|HIGH|MEDIUM|LOW|MINOR)\]|\#{1,4}\s*(?:\d+[\.\)]\s*)?\[(?:CRITICAL|MAJOR|MODERATE|SEVERE|HIGH|MEDIUM|LOW|MINOR)\]))/i
    raw_blocks = content.split(sep_regex)
    blocks = raw_blocks.select { |b| b =~ /\[LOCATION\]:/i || b =~ /\[ROOT CAUSE\]:/i }
    return blocks if blocks.any?

    # If no severity tags at all, split on [LOCATION]:
    loc_blocks = content.split(/(?=\n\s*\[LOCATION\]:)/i).select { |b| b =~ /\[LOCATION\]:/i }
    return loc_blocks if loc_blocks.any?

    content.split(/(?=\n\s*\#{2,4}\s+(?:Issue|Finding|\d+[\.\)]))/i).select { |b| b =~ /\[LOCATION\]:/i || b =~ /remediation/i }
  end

  def extract_block_severity(block)
    if block =~ /^\s*\[SEVERITY(?::\s*|\s*\]:?\s*)([a-zA-Z]+)/i
      return $1
    end
    if block =~ /^\s*(?:\*\*Severity\*\*|(?<!\[)Severity):\s*([a-zA-Z]+)/i
      return $1
    end
    if block =~ /^\s*(?:\#{1,4}\s*)?(?:\d+[\.\)]\s*)?\[(CRITICAL|MAJOR|MODERATE|SEVERE|HIGH|MEDIUM|LOW|MINOR)\]/i
      return $1
    end
    nil
  end

  def extract_severity_breakdown(review_content)
    counts = { 'severe' => 0, 'major' => 0, 'medium' => 0, 'minor' => 0, 'other' => 0 }
    return counts if review_content.nil? || review_content.empty?

    blocks = extract_issue_blocks(review_content)
    if blocks.any?
      blocks.each do |block|
        level = extract_block_severity(block)
        categorize_severity(level, counts)
      end
      return counts
    end

    # Fallback for freeform/unblocked reviews
    review_content.scan(/\[SEVERITY(?::\s*|\s*\]:?\s*)([a-zA-Z]+)/i).each do |(level)|
      categorize_severity(level, counts)
    end
    return counts if counts.values.sum.positive?

    bracket_regex = /^\s*(?:\#{1,4}\s*)?(?:\d+[\.\)]\s*)?\[(CRITICAL|MAJOR|MODERATE|SEVERE|HIGH|MEDIUM|LOW|MINOR)\](?:\s*[:\-].*|\s*)$/i
    review_content.scan(bracket_regex).each do |(level)|
      categorize_severity(level, counts)
    end

    counts
  end

  def categorize_severity(level, counts)
    case (level || '').downcase
    when /crit|sever|block/ then counts['severe'] += 1
    when /maj|high/        then counts['major'] += 1
    when /mod|med/         then counts['medium'] += 1
    when /min|low|info/    then counts['minor'] += 1
    else counts['other'] += 1
    end
  end

  def colorize_severity_count(count, level_type)
    return '0'.green if count.zero?

    case level_type
    when :severe then count.to_s.bold.red
    when :major  then count.to_s.bold.yellow
    when :medium then count.to_s.bold.cyan
    when :minor  then count.to_s.bold.blue
    else count.to_s
    end
  end

  def format_status_label(outcome)
    case outcome
    when 'remediated'      then 'Remediated & Verified (Quality Gate Passed)'.bold.green
    when 'clean'           then 'Clean (Zero Defects Detected)'.bold.green
    when 'failed_sandbox'  then 'Remediation Failed in Sandbox (Rolled Back)'.bold.red
    when 'failed_gate'     then 'Quality Gate Failed Post-Merge (Rolled Back)'.bold.red
    when 'rejected_diff'   then 'Diff Footprint Exceeded (Rolled Back)'.bold.red
    when 'dry_run'         then 'Dry Run (No Changes Applied)'.bold.yellow
    else outcome.to_s.capitalize.yellow
    end
  end

  def emit_summary_line(line)
    puts line
    log_write("#{line}\n")
  end

  def print_summary_issues(findings, severities)
    if findings.zero?
      emit_summary_line('  • Issues Found    : '.bold + '0 defects (Clean bill of health)'.bold.green)
      emit_summary_line("    - Severe (Critical) : #{'0'.green}")
      emit_summary_line("    - Major (High)      : #{'0'.green}")
      emit_summary_line("    - Medium (Moderate) : #{'0'.green}")
      emit_summary_line("    - Minor (Low)       : #{'0'.green}")
    else
      emit_summary_line('  • Issues Found    : '.bold + "#{findings} defect(s) detected".bold.yellow)
      emit_summary_line("    - Severe (Critical) : #{colorize_severity_count(severities['severe'], :severe)}")
      emit_summary_line("    - Major (High)      : #{colorize_severity_count(severities['major'], :major)}")
      emit_summary_line("    - Medium (Moderate) : #{colorize_severity_count(severities['medium'], :medium)}")
      emit_summary_line("    - Minor (Low)       : #{colorize_severity_count(severities['minor'], :minor)}")
      emit_summary_line("    - Unclassified      : #{severities['other'].to_s.gray}") if severities['other'] > 0
    end
  end

  def print_summary_files(footprint, outcome)
    files = footprint ? (footprint[:files] || []) : []
    stat_str = footprint ? footprint[:stat] : nil

    if files.empty?
      note = outcome == 'clean' ? '0 files (clean audit, no changes needed)'.green : '0 files'.yellow
      emit_summary_line('  • Files Edited    : '.bold + note)
    else
      diff_note = stat_str && !stat_str.empty? ? " (#{stat_str})" : ''
      emit_summary_line('  • Files Edited    : '.bold + "#{files.size} file(s)#{diff_note}".bold.green)
      files.first(8).each { |f| emit_summary_line("    - #{f}".gray) }
      emit_summary_line("    - ... and #{files.size - 8} more file(s)".gray) if files.size > 8
    end
  end

  def print_bottom_summary(num:, profile:, model_step:, findings:, review_content: nil, footprint: nil, outcome: 'remediated')
    severities = extract_severity_breakdown(review_content)
    known = severities['severe'] + severities['major'] + severities['medium'] + severities['minor']
    severities['other'] = findings - known if findings > known

    sep = ('─' * 74).cyan
    emit_summary_line("\n#{sep}")
    emit_summary_line(" 📋 REVIEW CYCLE SUMMARY [##{num}]".bold.cyan)
    emit_summary_line(sep)

    emit_summary_line('  • Review Type     : '.bold + "#{profile.upcase} (#{profile} audit)".cyan)
    model_str = "#{model_step[:label]} [backend: #{model_step[:backend]}, tier: #{model_step[:tier]}]"
    emit_summary_line('  • Model Used      : '.bold + model_str.yellow)

    print_summary_issues(findings, severities)
    print_summary_files(footprint, outcome)
    emit_summary_line('  • Status          : '.bold + format_status_label(outcome))

    emit_summary_line("#{sep}\n")
  end

  def print_loop_summary(total_cycles, clean_profiles)
    sep = ('─' * 74).cyan
    puts "\n#{sep}"
    puts " 🏁 REVIEW CYCLE LOOP COMPLETED (#{total_cycles} cycles executed)".bold.cyan
    puts sep
    puts '  • Cycles Executed : '.bold + total_cycles.to_s.yellow
    clean_str = "#{clean_profiles.size}/#{AUDIT_PROFILES.size} (#{clean_profiles.to_a.join(', ')})"
    puts '  • Clean Profiles  : '.bold + (clean_profiles.size == AUDIT_PROFILES.size ? clean_str.bold.green : clean_str.yellow)
    puts "#{sep}\n"
  end

  def build_summary(num, profile, model_step, findings, footprint: nil, diff_audit: nil)
    plan_file = Dir.glob("#{reports_dir}/#{num}*plan*.md").first
    report_file = Dir.glob("#{reports_dir}/#{num}_#{profile}.md").first ||
                  Dir.glob("#{reports_dir}/#{num}*.md").reject { |f| f =~ /plan|summary/ }.first

    issues = extract_issues_from_plan(plan_file)
    issues = extract_issues_from_report(report_file) if issues.empty?

    count = issues.any? ? issues.size : findings
    lines = [
      "# Review Cycle #{num} Summary (Lens: #{profile})",
      '',
      "- **Round**: #{num}",
      "- **Focus Lens**: `#{profile}`",
      "- **Auditor**: #{model_step[:label]}",
      "- **Issues Found**: #{count}",
      "- **Status**: Remediated & Verified"
    ]
    if footprint && footprint[:stat] && !footprint[:stat].empty?
      lines << "- **Footprint**: #{footprint[:stat]}"
    end
    if diff_audit
      audit_label = diff_audit[:findings].zero? ? 'Clean (0 defects in diff)' : "#{diff_audit[:findings]} warning(s)"
      lines << "- **Differential Audit**: #{audit_label}"
    end
    lines << ''
    lines << '## Issues & Mitigations'
    lines << ''

    if issues.empty?
      lines << "1. **Issue**: #{count} defect(s) identified during audit."
      lines << '   - **Mitigation**: All identified defects resolved and verified via quality gate.'
    else
      issues.each_with_index do |it, i|
        loc_part = it[:loc] ? " (`#{it[:loc]}`)" : ''
        lines << "#{i + 1}. **Issue**: #{it[:desc]}#{loc_part}"
        lines << "   - **Mitigation**: #{it[:rem]}"
      end
    end

    lines.join("\n") + "\n"
  end

  def extract_issues_from_plan(plan_file)
    return [] unless plan_file && File.exist?(plan_file)

    content = File.read(plan_file)
    items = extract_table_issues(content)
    return items unless items.empty?

    extract_section_issues(content)
  end

  def extract_table_issues(content)
    table_lines = content.lines.select { |l| l.strip.start_with?('|') }
    return [] if table_lines.size < 3

    header = table_lines[0].split('|').map(&:strip).reject(&:empty?)
    issue_col = header.index { |h| h =~ /issue\s*(summary|name|desc)|defect\s*classification/i }
    rem_col = header.index { |h| h =~ /target\s*resolution|remediated\s*by|fix|resolution/i }
    loc_col = header.index { |h| h =~ /component|subsystems?|location|target/i }
    return [] unless issue_col && rem_col

    items = []
    table_lines[2..].each do |row|
      cols = row.split('|').map(&:strip).reject(&:empty?)
      next if cols.empty? || cols.all? { |c| c =~ /^[ \-:]+$/ }

      desc = cols[issue_col]
      rem = cols[rem_col]
      loc = loc_col ? cols[loc_col] : nil
      if desc && rem
        items << {
          desc: desc.gsub(/[`*]/, '').strip,
          rem: rem.gsub(/[`*]/, '').strip,
          loc: loc&.gsub(/[`*]/, '')&.strip
        }
      end
    end
    items
  end

  def extract_section_issues(content)
    items = []
    content.scan(/###\s+(?:Issue\s*\d*[:.]?\s*)?([^\n]+)(.*?)(?=###|\Z)/m).each do |title, body|
      desc = title.strip.gsub(/[`*]/, '')
      fix = body[/(?:-\s*\*\*Fix\*\*|\*\*Resolution\*\*|Remediation)[:\s]*([^\n]+)/i, 1]
      items << { desc: desc, rem: fix.strip.gsub(/[`*]/, '') } if fix
    end
    items
  end

  def extract_issues_from_report(report_file)
    return [] unless report_file && File.exist?(report_file)

    content = File.read(report_file)
    blocks = extract_issue_blocks(content)
    return extract_severity_blocks(blocks) if blocks.any?

    extract_markdown_heading_issues(content)
  end

  def extract_severity_blocks(blocks)
    blocks.map do |block|
      loc = block[/\[LOCATION\]:\s*(.+)/i, 1]&.strip&.gsub(/[`*]/, '')
      root_cause = block[/\[ROOT CAUSE\]:\s*(.+?)(?=\n\s*\[|\Z)/im, 1]&.strip
      desc = clean_first_sentence(root_cause) || "Issue detected in #{loc || 'codebase'}"
      desc = desc[0..130] + '...' if desc.length > 133

      remediation = block[/\[REMEDIATION\]:\s*(.+?)(?=\n\s*---|\Z)/im, 1]&.strip
      rem = clean_remediation_line(remediation)
      rem = rem[0..130] + '...' if rem.length > 133

      { desc: desc, rem: rem, loc: loc }
    end
  end

  def clean_first_sentence(text)
    return nil unless text

    first_line = text.lines.first.strip
    combined = if first_line.length < 35 && text.lines[1]
                 first_line + ' ' + text.lines[1].strip
               else
                 first_line
               end
    combined.gsub(/[`*]/, '').sub(/\A[^a-zA-Z0-9]+/, '').strip
  end

  def clean_remediation_line(remediation)
    return 'Remediated' unless remediation

    outside_code = remediation.gsub(/```[a-zA-Z0-9_-]*\n.*?```/m, '').strip
    prose = outside_code.lines.map(&:strip).reject(&:empty?).reject { |l| l =~ /^[>\-*#]/ }.first
    if prose && prose.length > 5
      return prose.sub(/^\((.+)\)$/, '\1').gsub(/[`*]/, '').sub(/\A[^a-zA-Z0-9]+/, '').strip
    end

    comment = remediation.scan(/(?<!:)\/\/\s*([^\n]+)/).flatten.reject { |c| c =~ /resolve\(\)/ }.first
    return comment.gsub(/[`*]/, '').strip if comment && comment.length > 5

    code_line = remediation.lines.reject { |l| l.strip.empty? || l.strip.start_with?('```') }.first&.strip
    code_line ? "Code fix: `#{code_line[0..60]}`" : 'Resolved in code'
  end

  def extract_markdown_heading_issues(content)
    items = []
    content.scan(/###\s+\d+\.\s*\[(?:CRITICAL|MAJOR|MODERATE)\]\s*([^\n]+)(.*?)(?=###|\Z)/m).each do |title, body|
      desc = title.strip.gsub(/[`*]/, '')
      rem = body[/(?:-\s*\*\*Remediation\*\*|Remediation)[:\s]*([^\n]+)/i, 1]
      clean_rem = rem ? rem.strip.gsub(/[`*]/, '') : 'Remediated'
      clean_rem = clean_rem[0..130] + '...' if clean_rem.length > 133
      items << { desc: desc, rem: clean_rem }
    end
    items
  end

  def archive_artifacts(num)
    arch_path = archive_dir
    puts "\n==> [Phase 5/5] Archiving review #{num} artifacts to #{arch_path}/...".bold.cyan
    FileUtils.mkdir_p(arch_path)
    self.class.ensure_gitignores(reports_dir)

    files = (Dir.glob("#{reports_dir}/#{num}*.md") + Dir.glob("#{num}*.md")).uniq
    return if files.empty?

    files.each do |file|
      dest = File.join(arch_path, File.basename(file))
      if system('git', 'ls-files', '--error-unmatch', file, out: File::NULL, err: File::NULL)
        system('git', 'rm', '--cached', file, out: File::NULL, err: File::NULL)
      end
      FileUtils.mv(file, dest)
      puts "  Archived: #{file} -> #{dest}".cyan
    end

    puts "Review #{num} artifacts safely archived in #{arch_path}/ (untracked by git).".green
  end

  def record_history(num, profile, model_step, findings, outcome, files_edited: nil)
    @state['history'] ||= []
    summary_loc = options[:keep_reviews] ? "#{reports_dir}/#{num}_summary.md" : "#{reports_dir}/archive/#{num}_summary.md"
    entry = {
      'number' => num,
      'profile' => profile,
      'model' => model_step[:label],
      'tier' => model_step[:tier],
      'backend' => model_step[:backend],
      'findings' => findings,
      'outcome' => outcome,
      'log' => @current_log_path ? File.join(reports_dir, 'logs', File.basename(@current_log_path)) : nil,
      'timestamp' => Time.now.utc.iso8601
    }
    entry['files_edited'] = files_edited unless files_edited.nil?
    entry['summary'] = summary_loc if outcome == 'remediated'
    @state['history'] << entry
    save_state
  end

  def commit_and_push_cycle(num, profile, clean: false)
    dirty = `git status --porcelain #{reports_dir} #{state_file_path}`.strip
    unless dirty.empty?
      system('git', 'add', reports_dir, state_file_path)
      msg = clean ? "chore(review): record clean audit for #{profile}" : "chore(review): finalize cycle #{num} (#{profile}) state"
      system('git', 'commit', '-m', msg)
    end

    return unless options[:push]

    if options[:batch_commits] && options[:loop]
      puts '  [Batch Commits] Deferring remote push until loop completion.'.cyan
      return
    end
    if system('git', 'push')
      puts 'Successfully pushed commits to remote.'.green
    else
      warn '⚠️ Warning: git push failed. Commits remain local.'.yellow
    end
  end

  def self.resolve_reports_dir(opts = {})
    opts[:reports_dir] || ENV['REPORTS_DIR'] || (Dir.exist?(File.join(REPO_ROOT, 'reports')) ? 'reports' : 'reviews')
  end

  def self.state_file_path(dir = nil)
    dir ||= resolve_reports_dir
    primary = File.join(REPO_ROOT, dir, 'state.json')
    return primary if File.exist?(primary)

    legacy = [File.join(REPO_ROOT, '.review_state.json'), File.join(REPO_ROOT, 'review_state.json')].find { |f| File.exist?(f) }
    legacy || primary
  end

  def self.default_config_paths
    [
      File.join(REPO_ROOT, 'tools', 'review_cycle.json'),
      File.join(REPO_ROOT, 'config', 'review_cycle.json'),
      File.join(REPO_ROOT, 'review_cycle.json'),
      File.join(REPO_ROOT, '.review_cycle.json'),
      File.join(REPO_ROOT, '.review.json')
    ]
  end

  def self.default_config_target
    if Dir.exist?(File.join(REPO_ROOT, 'tools'))
      File.join(REPO_ROOT, 'tools', 'review_cycle.json')
    elsif Dir.exist?(File.join(REPO_ROOT, 'config'))
      File.join(REPO_ROOT, 'config', 'review_cycle.json')
    else
      File.join(REPO_ROOT, 'review_cycle.json')
    end
  end

  def self.ensure_gitignores(dir = nil)
    dir ||= resolve_reports_dir
    ensure_dir_gitignore(File.join(REPO_ROOT, dir, 'archive'))
    ensure_dir_gitignore(File.join(REPO_ROOT, dir, 'logs'))
  end

  def self.ensure_dir_gitignore(dir)
    FileUtils.mkdir_p(dir)
    gi_path = File.join(dir, '.gitignore')
    return if File.exist?(gi_path)

    File.write(gi_path, "*\n!.gitignore\n")
  end

  def self.reset_state(options = {})
    s_path = state_file_path(resolve_reports_dir(options))
    initial_state = {
      'last_profile_index' => -1,
      'last_cadence_index' => -1,
      'history' => []
    }
    FileUtils.mkdir_p(File.dirname(s_path))
    File.write(s_path, JSON.pretty_generate(initial_state))
    puts "Reset #{s_path} to initial state.".green
  end

  def self.show_status(options = {})
    s_path = state_file_path(resolve_reports_dir(options))
    state = load_status_state(s_path)
    p_idx = state['last_profile_index'] || -1
    c_idx = state['last_cadence_index'] || -1
    history = state['history'] || []

    print_status_header(s_path, p_idx, c_idx, history.size)
    print_status_history(history)
  end

  def self.load_status_state(path)
    return {} unless File.exist?(path)

    JSON.parse(File.read(path))
  rescue StandardError
    {}
  end

  def self.print_status_header(s_path, p_idx, c_idx, total_cycles)
    next_p_idx = (p_idx + 1) % AUDIT_PROFILES.size
    next_profile = AUDIT_PROFILES[next_p_idx]
    next_c_idx = (c_idx + 1) % MODEL_CADENCE.size
    next_model = MODEL_CADENCE[next_c_idx]

    puts "\n" + ('=' * 68).cyan
    puts " 📊 Autonomous Review Cycle State (#{s_path})".bold.cyan
    puts ('=' * 68).cyan
    puts "  • Last Profile Index : #{p_idx} (#{p_idx >= 0 ? AUDIT_PROFILES[p_idx] : 'None'})"
    puts "  • Next Profile       : #{next_profile} [#{next_p_idx + 1}/#{AUDIT_PROFILES.size}]".bold.yellow
    puts "  • Last Cadence Index : #{c_idx}"
    puts "  • Next Model Step    : #{next_model[:label]} [Step #{next_c_idx + 1}/#{MODEL_CADENCE.size}]".bold.yellow
    puts "  • Total Cycles Run   : #{total_cycles}"
  end

  def self.print_status_history(history)
    if history.any?
      puts "\n  Recent Cycle History (Last 5):".bold
      history.last(5).each do |h|
        tag = "[##{h['number']}] #{h['profile']} (#{h['model']}) -> #{h['findings']} defect(s), #{h['outcome']}"
        puts(h['outcome'] == 'clean' ? "    - #{tag}".green : "    - #{tag}".yellow)
      end
    else
      puts "\n  No review cycles recorded yet.".yellow
    end
    puts ('=' * 68).cyan + "\n"
  end

  def self.archive_all(options = {})
    instance = new(options)
    rep_dir = instance.reports_dir
    arch_dir = instance.archive_dir
    ensure_gitignores(rep_dir)

    candidates = collect_unarchived_files(rep_dir, arch_dir)
    if candidates.empty?
      puts "No unarchived review artifacts found in #{rep_dir}/.".green
      return
    end

    puts "Archiving #{candidates.size} review artifact(s) into #{arch_dir}/...".cyan
    candidates.each { |file| move_to_archive(file, arch_dir) }
    puts "All artifacts archived in #{arch_dir}/ (untracked by git).".green
  end

  def self.collect_unarchived_files(rep_dir, arch_dir)
    patterns = [
      File.join(REPO_ROOT, rep_dir, '[0-9][0-9][0-9]_*.md'),
      File.join(REPO_ROOT, rep_dir, '*_plan.md'),
      File.join(REPO_ROOT, rep_dir, '*_summary.md'),
      File.join(REPO_ROOT, '[0-9][0-9][0-9]_*.md')
    ]
    patterns.flat_map { |p| Dir.glob(p) }.uniq.reject { |f| f.start_with?(arch_dir) }
  end

  def self.move_to_archive(file, arch_dir)
    dest = File.join(arch_dir, File.basename(file))
    if system('git', 'ls-files', '--error-unmatch', file, out: File::NULL, err: File::NULL)
      system('git', 'rm', '--cached', file, out: File::NULL, err: File::NULL)
    end
    FileUtils.mv(file, dest)
    puts "  Archived: #{File.basename(file)} -> #{arch_dir}/".cyan
  end

  def self.build_default_config
    instance = new({})
    audit_tool = [File.join(REPO_ROOT, 'tools', 'gate_audit_code'), File.join(REPO_ROOT, 'tools', 'audit_code')].find { |f| File.exist?(f) }
    guideline = if audit_tool
                  "Adhere strictly to tools/#{File.basename(audit_tool)} (method length <= 80 lines [<= 120 lines if complexity <= 5], cognitive complexity <= 15, depth <= 4)"
                elsif File.exist?(File.join(REPO_ROOT, 'AGENTS.md'))
                  'Adhere strictly to AGENTS.md guidelines'
                end

    gate = instance.resolve_gate_cmd
    gate = gate.sub(%r{^#{Regexp.escape(REPO_ROOT)}/}, '') if gate&.start_with?(REPO_ROOT)

    build = instance.resolve_build_cmd
    build = build.sub(%r{^#{Regexp.escape(REPO_ROOT)}/}, '') if build&.start_with?(REPO_ROOT)

    audit = instance.resolve_audit_executable || 'tools/audit'
    audit = audit.sub(%r{^#{Regexp.escape(REPO_ROOT)}/}, '') if audit&.start_with?(REPO_ROOT)

    {
      target: instance.target_directory,
      gate_cmd: gate,
      build_cmd: build,
      audit_cmd: audit,
      guidelines: guideline,
      max_diff_lines: 800
    }.compact
  end

  def self.generate_config_template(output_path = nil)
    output_path ||= default_config_target
    cfg = build_default_config
    FileUtils.mkdir_p(File.dirname(output_path))
    File.write(output_path, JSON.pretty_generate(cfg) + "\n")
    puts "Wrote configuration template to #{output_path}".green
    puts JSON.pretty_generate(cfg)
  end

  def self.agents_doc
    <<~MARKDOWN
      ## Autonomous Review Cycle (`tools/review_cycle`)

      Single-command orchestration executing adversarial review, sandbox remediation, and quality gate verification.
      Complete specification: [`tools/REVIEW_CYCLE.md`](tools/REVIEW_CYCLE.md)

      ### Pipeline Execution Phases:
      1. **Audit**: Runs multi-lens audit (`tools/audit`), producing `<reports-dir>/<NUM>_<profile>.md`.
      2. **Remediation**: Dispatches sandbox agent (`bws gw` + `agy-run-wild`) to create `<reports-dir>/<NUM>_<profile>_plan.md`, apply fixes, author regression tests, and squash-merge.
      3. **Quality Gate & Rollback**: Runs quality gate (auto-detected or `--gate-cmd`). If sandbox or gate fails, automatically rolls back workspace to pre-cycle commit.
      4. **Verification & Summary**: Inspects diff footprint (`--max-diff-lines`), runs differential re-audit on patch (`tools/audit`), and generates `<reports-dir>/<NUM>_summary.md`.
      5. **Archive & Push**: Moves artifacts to `<reports-dir>/archive/`, records `<reports-dir>/state.json`, and pushes to remote (`--no-push` to bypass).

      ### 4:2:1 Pyramid Cadence & 6-Lens Balancing:
      Rotates models: `[Flash, Flash, Tier 1, Flash, Flash, Tier 1, Tier 2]` (4 Gemini Flash : 2 Claude/Codex : 1 Opus).
      Round-robins across the 6 audit lenses (`systems`, `security`, `correctness`, `resilience`, `performance`, `cli`).
      Because gcd(6, 7) = 1, every lens is audited by every model tier over a 42-cycle non-repeating sequence.

      ### Invariants:
      - Enforce repository sizing and architectural invariants (e.g. AGENTS.md).
      - Transactional rollback on failure: no broken code left on working branch.
      - Mandatory regression test for every remediated defect.
    MARKDOWN
  end

  def self.run_doctor
    puts "\e[1m=== Review Cycle Environment Doctor ===\e[0m\n\n"
    checks = []

    # 1. Ruby runtime
    ruby_ok = RUBY_VERSION >= '3.0.0'
    checks << [ruby_ok, "Ruby runtime (v#{RUBY_VERSION})", ruby_ok ? ">= 3.0" : "Requires Ruby >= 3.0"]

    # 2. Git binary
    git_bin = `which git 2>/dev/null`.strip
    git_ok = !git_bin.empty?
    checks << [git_ok, "Git binary (#{git_bin.empty? ? 'missing' : git_bin})", git_ok ? "Available" : "Git not found in PATH"]

    # 3. Git repo context
    in_repo = system('git rev-parse --is-inside-work-tree >/dev/null 2>&1')
    checks << [in_repo, "Git repository context", in_repo ? "Valid git repository" : "Not inside a git repository"]

    # 4. bws sandbox tool
    bws_bin = `which bws 2>/dev/null`.strip
    bws_ok = !bws_bin.empty?
    checks << [bws_ok, "bws sandbox tool (#{bws_bin.empty? ? 'missing' : bws_bin})", bws_ok ? "Available" : "Install from https://github.com/sarielhp/bws"]

    # 5. agy-run-wild agent runner
    agy_bin = `which agy-run-wild 2>/dev/null`.strip
    agy_ok = !agy_bin.empty?
    checks << [agy_ok, "agy-run-wild agent runner (#{agy_bin.empty? ? 'missing' : agy_bin})", agy_ok ? "Available" : "Required for autonomous sandbox execution"]

    # 6. Audit tool
    audit_candidates = [
      File.join(REPO_ROOT, 'tools', 'audit'),
      File.join(REPO_ROOT, 'tools', 'audit.rb'),
      File.expand_path('audit', __dir__),
      File.expand_path('audit.rb', __dir__),
      File.join(REPO_ROOT, 'audit'),
      `which audit 2>/dev/null`.strip
    ]
    audit_bin = audit_candidates.find { |f| !f.nil? && !f.empty? && File.exist?(f) }
    audit_ok = !audit_bin.nil?
    checks << [audit_ok, "Audit executable (#{audit_bin || 'missing'})", audit_ok ? "Available" : "tools/audit not found (symlink from standards/workflow/bin/audit)"]

    checks.each do |ok, label, detail|
      mark = ok ? "\e[32m✔\e[0m" : "\e[31m✗\e[0m"
      puts format("  %s \e[1m%-35s\e[0m %s", mark, label, detail)
    end

    all_ok = checks.all?(&:first)
    puts "\n" + (all_ok ? "\e[32mAll prerequisites met! Review cycle engine ready.\e[0m\n" : "\e[33mSome prerequisites are missing. Address notices above before running full cycles.\e[0m\n")
  end

  def self.setup_ensure_git!
    return if system('git rev-parse --is-inside-work-tree >/dev/null 2>&1')

    puts "\n❌ [Fatal Error] review-cycle setup must be executed inside a valid Git repository.".bold.red
    puts "   Run 'git init' first before setting up review_cycle.\n\n"
    exit 1
  end

  def self.setup_generate_config
    target_path = default_config_target
    if File.file?(target_path)
      puts "  ✔ Config file already exists: #{target_path}".green
      return target_path
    end

    cfg = build_default_config
    FileUtils.mkdir_p(File.dirname(target_path))
    File.write(target_path, JSON.pretty_generate(cfg) + "\n")
    puts "  ✔ Created configuration contract: #{target_path}".green
    target_path
  end

  def self.setup_provision_audit
    tools_dir = File.join(REPO_ROOT, 'tools')
    FileUtils.mkdir_p(tools_dir)
    target_audit = File.join(tools_dir, 'audit')
    if File.exist?(target_audit)
      puts "  ✔ Audit executable already present: #{target_audit}".green
      return
    end

    standards_audit = File.expand_path('audit', __dir__)
    if File.exist?(standards_audit)
      FileUtils.ln_sf(standards_audit, target_audit)
      puts "  ✔ Symlinked #{target_audit} -> #{standards_audit}".green
    else
      puts "  ℹ Audit executable will run via global path".cyan
    end
  end

  def self.setup_update_gitignore(rep_dir = 'reviews')
    gitignore_file = File.join(REPO_ROOT, '.gitignore')
    entries = ["#{rep_dir}/archive/", "#{rep_dir}/logs/"]
    existing = File.exist?(gitignore_file) ? File.read(gitignore_file) : ''

    missing = entries.reject { |e| existing.include?(e) }
    return if missing.empty?

    new_content = existing.dup
    new_content << "\n" unless new_content.empty? || new_content.end_with?("\n")
    new_content << "# Review cycle artifacts\n"
    missing.each { |m| new_content << "#{m}\n" }
    File.write(gitignore_file, new_content)
    puts "  ✔ Added #{missing.join(', ')} to .gitignore".green
  end

  def self.setup_update_agents_doc
    agents_file = File.join(REPO_ROOT, 'AGENTS.md')
    if File.exist?(agents_file)
      content = File.read(agents_file)
      if content.include?('Autonomous Review Cycle') || content.include?('review_cycle')
        puts "  ✔ AGENTS.md already contains review cycle instructions".green
      else
        content << "\n\n" unless content.end_with?("\n\n")
        content << agents_doc
        File.write(agents_file, content)
        puts "  ✔ Appended review cycle instructions to AGENTS.md".green
      end
    else
      File.write(agents_file, "# Agent Guidelines\n\n#{agents_doc}\n")
      puts "  ✔ Created AGENTS.md with review cycle instructions".green
    end
  end

  def self.setup_print_agent_briefing(config_path)
    puts "\n\e[1m=== AI Agent Operational Briefing ===\e[0m\n\n"
    puts "Review cycle configured for repository: \e[36m#{REPO_ROOT}\e[0m"
    puts "Configuration contract: \e[33m#{config_path}\e[0m\n\n"
    puts "Available operational commands:"
    puts "  1. \e[1;32mreview-cycle\e[0m             Run a single review round (audit -> plan -> sandbox fix -> gate -> verify -> commit)"
    puts "  2. \e[1;32mreview-cycle --loop\e[0m      Continuously audit and heal until all 6 profiles pass clean"
    puts "  3. \e[1;32mreview-cycle -p <lens>\e[0m   Target a specific profile (systems, security, correctness, resilience, performance, cli)"
    puts "  4. \e[1;32mreview-cycle --status\e[0m    Inspect review state machine, history, and model rotation"
    puts "  5. \e[1;32mreview-cycle --doctor\e[0m    Verify sandbox and auditor dependencies\n\n"
    puts "Invariants enforced: Sizing limits (AGENTS.md), transactional rollback on gate failure, zero test weakening.\n\n"
  end

  def self.run_setup(options = {})
    puts "\e[1m=== Review Cycle Repository Setup ===\e[0m\n\n"
    setup_ensure_git!

    puts "1. Checking Environment Prerequisites:"
    run_doctor

    puts "2. Initializing Repository Configuration:"
    setup_provision_audit
    cfg_path = setup_generate_config
    setup_update_gitignore
    setup_update_agents_doc

    setup_print_agent_briefing(cfg_path)
  end
end

if __FILE__ == $PROGRAM_NAME
  parser.parse!(ARGV)
  MultiProfileReviewCycle.new(options).run
end
